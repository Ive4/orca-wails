diff --git a/src/main/runtime/rpc/methods/emulator/emulator-frame-stream.test.ts b/src/main/runtime/rpc/methods/emulator/emulator-frame-stream.test.ts
new file mode 100644
index 0000000..0681ece
--- /dev/null
+++ b/src/main/runtime/rpc/methods/emulator/emulator-frame-stream.test.ts
@@ -0,0 +1,72 @@
+import { createServer } from 'node:http'
+import { expect, test, vi } from 'vitest'
+import { streamEmulatorFrames } from './emulator-frame-stream'
+
+test('delivers complete JPEG frames and closes the source on abort', async () => {
+  const controller = new AbortController()
+  const jpeg = Buffer.from([0xff, 0xd8, 0xff, 0xd9])
+  const closed = vi.fn()
+  const server = createServer((req, res) => {
+    expect(req.url).toBe('/stream.mjpeg?raw=1')
+    res.on('close', closed)
+    res.writeHead(200, { 'Content-Type': 'application/octet-stream' })
+    res.write(jpeg.subarray(0, 2))
+    res.write(jpeg.subarray(2))
+  })
+  try {
+    await new Promise<void>((resolve) => server.listen(0, '127.0.0.1', resolve))
+    const address = server.address()
+    if (!address || typeof address === 'string') throw new Error('Expected a listening socket')
+    const send = vi.fn((frame: Uint8Array<ArrayBufferLike>) => {
+      expect(Buffer.from(frame)).toEqual(jpeg)
+      controller.abort()
+      return true
+    })
+    await streamEmulatorFrames(`http://127.0.0.1:${address.port}/stream.mjpeg`, {
+      signal: controller.signal,
+      sendBinary: send,
+      onError: () => {}
+    })
+    expect(send).toHaveBeenCalledTimes(1)
+    await vi.waitFor(() => expect(closed).toHaveBeenCalledTimes(1))
+  } finally {
+    controller.abort()
+    server.closeAllConnections()
+    await new Promise<void>((resolve) => server.close(() => resolve()))
+  }
+})
+
+test('rejects remote hosts and endpoints outside the paired simulator stream', async () => {
+  const sendBinary = vi.fn(() => true)
+  for (const url of [
+    'http://192.0.2.2:5000/stream.mjpeg',
+    'http://127.0.0.1/stream.mjpeg',
+    'http://127.0.0.1:5000/control',
+    'http://user@127.0.0.1:5000/stream.mjpeg'
+  ]) {
+    await expect(streamEmulatorFrames(url, { sendBinary, onError: () => {} })).rejects.toThrow()
+  }
+  expect(sendBinary).not.toHaveBeenCalled()
+})
+
+test('ends after the local helper rejects the stream', async () => {
+  const requests = vi.fn()
+  const server = createServer((_req, res) => {
+    requests()
+    res.writeHead(503).end()
+  })
+  try {
+    await new Promise<void>((resolve) => server.listen(0, '127.0.0.1', resolve))
+    const address = server.address()
+    if (!address || typeof address === 'string') throw new Error('Expected a listening socket')
+    const onError = vi.fn()
+    const sendBinary = vi.fn(() => true)
+    await streamEmulatorFrames(`http://127.0.0.1:${address.port}/stream.mjpeg`, { sendBinary, onError })
+    expect(requests).toHaveBeenCalledOnce()
+    expect(onError).toHaveBeenCalledOnce()
+    expect(sendBinary).not.toHaveBeenCalled()
+  } finally {
+    server.closeAllConnections()
+    await new Promise<void>((resolve) => server.close(() => resolve()))
+  }
+})
diff --git a/src/main/runtime/rpc/methods/emulator/emulator-frame-stream.ts b/src/main/runtime/rpc/methods/emulator/emulator-frame-stream.ts
new file mode 100644
index 0000000..b937f9d
--- /dev/null
+++ b/src/main/runtime/rpc/methods/emulator/emulator-frame-stream.ts
@@ -0,0 +1,53 @@
+import { MjpegFrameStream } from '../../../../emulator/mjpeg-frame-stream'
+import { EmulatorError } from '../../../../emulator/emulator-errors'
+import { isRemoteRuntimeBinaryFrameWithinLimit } from '../../../../../shared/remote-runtime/remote-runtime-memory-limits'
+import type { RpcBinarySender } from '../../transports/rpc-binary-sender'
+
+export async function streamEmulatorFrames(
+  streamUrl: string,
+  {
+    signal,
+    sendBinary,
+    onError
+  }: {
+    signal?: AbortSignal
+    sendBinary: RpcBinarySender
+    onError: (message: string) => void
+  }
+): Promise<void> {
+  const url = new URL(streamUrl)
+  if (
+    url.protocol !== 'http:' ||
+    !['127.0.0.1', 'localhost', '[::1]'].includes(url.hostname) ||
+    !url.port ||
+    url.username ||
+    url.password ||
+    url.pathname !== '/stream.mjpeg'
+  ) {
+    throw new EmulatorError('emulator_no_active', 'The iOS simulator has no local frame stream.')
+  }
+  if (signal?.aborted) return
+  let stopped!: () => void
+  const done = new Promise<void>((resolve) => {
+    stopped = resolve
+  })
+  const stream = new MjpegFrameStream(url.href, {
+    onError: () => {
+      if (!signal?.aborted) onError('The iOS simulator stream disconnected.')
+      stopped()
+    },
+    onFrame: (image) => {
+      if (!signal?.aborted && isRemoteRuntimeBinaryFrameWithinLimit(image)) {
+        sendBinary(image, { dropWhenBacklogged: true })
+      }
+    }
+  })
+  signal?.addEventListener('abort', stopped, { once: true })
+  try {
+    stream.start()
+    await done
+  } finally {
+    signal?.removeEventListener('abort', stopped)
+    stream.stop()
+  }
+}
