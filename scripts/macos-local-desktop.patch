diff --git a/src/renderer/src/wails/local-pty.ts b/src/renderer/src/wails/local-pty.ts
new file mode 100644
index 0000000..5c6a744
--- /dev/null
+++ b/src/renderer/src/wails/local-pty.ts
@@ -0,0 +1,183 @@
+import type { PreloadApi } from '../../../preload/api-types'
+import { RuntimeRpcCallQueuePool } from '../../../shared/remote-runtime/rpc/runtime-rpc-call-queue'
+import type { RuntimeTerminalCreate } from '../../../shared/terminal/runtime/runtime-terminal-create-contract'
+import { callRuntimeResult } from '../web/runtime/client/web-runtime-calls'
+import { getClientForEnvironment } from '../web/runtime/client/web-runtime-session'
+import { createPtyApi } from '../web/preload-api/host-capabilities/web-terminal-api'
+import { localDesktopConnection } from './local-runtime'
+
+type Pty = PreloadApi['pty']
+type DataListener = Parameters<Pty['onData']>[0]
+type ExitListener = Parameters<Pty['onExit']>[0]
+type TerminalSize = { cols: number; rows: number }
+type TerminalEvent = {
+  type: 'scrollback' | 'subscribed' | 'data' | 'end'
+  lines?: string[]
+  serialized?: string
+  chunk?: string
+  cwd?: string
+  cols?: number
+  rows?: number
+}
+
+export function createWailsDesktopPtyApi(): Pty {
+  const api = createPtyApi()
+  const inputQueue = new RuntimeRpcCallQueuePool(1, 1)
+  const dataListeners = new Set<DataListener>()
+  const exitListeners = new Set<ExitListener>()
+  const connected = new Map<string, { cwd?: string; size: TerminalSize; close: () => void }>()
+  const client = { id: 'wails-desktop', type: 'desktop' } as const
+
+  function fire(method: string, params: { terminal: string } & Record<string, unknown>): void {
+    void callRuntimeResult(method, params).catch(console.warn)
+  }
+
+  const writeAccepted: Pty['writeAccepted'] = async (id, text, inputKind, options) => {
+    if (inputKind === 'query-reply') return false
+    // Each desktop RPC opens its own local connection; enqueue writes in the order xterm emits them.
+    return inputQueue.enqueue(id, 'terminal.send', async () => {
+      const { send } = await callRuntimeResult<{ send: { accepted: boolean } }>('terminal.send', {
+        terminal: id,
+        text,
+        client,
+        ...options
+      })
+      return send.accepted
+    }, text.length * 2)
+  }
+
+  return {
+    ...api,
+    spawn: async (args) => {
+      if (args.replacesPtyId && args.replacesPtyId !== args.sessionId) {
+        await callRuntimeResult('terminal.close', { terminal: args.replacesPtyId })
+      }
+      let terminal: RuntimeTerminalCreate | undefined
+      if (args.sessionId?.startsWith('term_')) {
+        const status = await callRuntimeResult<{ terminal: RuntimeTerminalCreate }>(
+          'terminal.show',
+          {
+            terminal: args.sessionId
+          }
+        ).catch(() => null)
+        if (status?.terminal.ptyId)
+          terminal = { ...status.terminal, handle: args.sessionId, isReattach: true }
+      }
+      if (!terminal) {
+        if (args.attachOnlyView) {
+          return { id: args.sessionId ?? '', sessionExpired: true }
+        }
+        const result = await callRuntimeResult<{ terminal: RuntimeTerminalCreate }>(
+          'terminal.create',
+          {
+            worktree: args.worktreeId ? `id:${args.worktreeId}` : undefined,
+            tabId: args.tabId,
+            leafId: args.leafId,
+            command: args.command,
+            env: args.env,
+            envToDelete: args.envToDelete,
+            startupCommandDelivery: args.startupCommandDelivery,
+            cwd: args.cwd,
+            shell: args.shellOverride,
+            launchConfig: args.launchConfig,
+            resumeProviderSession: args.resumeProviderSession,
+            launchToken: args.launchToken,
+            launchAgent: args.launchAgent,
+            trustWorktreeId: args.trustWorktreeId,
+            spawnIntent: args.spawnIntent,
+            terminalKittyKeyboardProtocol: args.terminalKittyKeyboardProtocol,
+            terminalColorQueryReplies: args.terminalColorQueryReplies,
+            presentation: 'background'
+          }
+        )
+        terminal = result.terminal
+      }
+      const id = terminal.handle
+      connected.get(id)?.close()
+      const size = { cols: args.cols, rows: args.rows }
+      const view = { cwd: args.cwd, size, close: () => {} }
+      connected.set(id, view)
+      const runtime = getClientForEnvironment(localDesktopConnection)
+      let initial: TerminalEvent | undefined
+      let resolveInitial: () => void = () => {}
+      const ready = new Promise<void>((resolve) => {
+        resolveInitial = resolve
+      })
+      const subscription = await runtime.subscribe(
+        'terminal.subscribe',
+        { terminal: id, client, viewport: size },
+        {
+          onResponse: (frame) => {
+            if (!frame.ok) {
+              resolveInitial()
+              return
+            }
+            const event = frame.result as TerminalEvent
+            if (event.type === 'data' && event.chunk) {
+              for (const listener of dataListeners) listener({ id, data: event.chunk })
+            } else if (event.type === 'scrollback' || event.type === 'subscribed') {
+              initial = event
+              view.cwd = event.cwd ?? view.cwd
+              resolveInitial()
+            } else if (event.type === 'end') {
+              resolveInitial()
+              if (connected.get(id) === view) {
+                connected.delete(id)
+                for (const listener of exitListeners) listener({ id, code: 0 })
+              }
+            }
+          },
+          onClose: () => {
+            resolveInitial()
+            if (connected.get(id) === view) connected.delete(id)
+          }
+        }
+      )
+      view.close = subscription.unsubscribe
+      const timeout = setTimeout(resolveInitial, 8_000)
+      await ready
+      clearTimeout(timeout)
+      return {
+        ...terminal,
+        id,
+        incarnationId: terminal.incarnationId ?? undefined,
+        snapshot: initial?.serialized ?? initial?.lines?.join('\r\n'),
+        snapshotCols: initial?.cols,
+        snapshotRows: initial?.rows
+      }
+    },
+    write: (id, data, inputKind) => {
+      void writeAccepted(id, data, inputKind).catch(console.warn)
+    },
+    writeAccepted,
+    resize: (id, cols, rows) => {
+      const view = connected.get(id)
+      if (view) view.size = { cols, rows }
+      fire('terminal.updateViewport', { terminal: id, client, viewport: { cols, rows } })
+    },
+    kill: async (id) => {
+      await callRuntimeResult('terminal.close', { terminal: id })
+      connected.get(id)?.close()
+      connected.delete(id)
+    },
+    clearBuffer: (id) => fire('terminal.clearBuffer', { terminal: id }),
+    resetInputModes: (id) => fire('terminal.resetInputModes', { terminal: id }),
+    hasPty: async (id) => {
+      if (!id.startsWith('term_')) return false
+      const response = await callRuntimeResult<{ terminal: { ptyId?: string } }>('terminal.show', {
+        terminal: id
+      }).catch(() => null)
+      return Boolean(response?.terminal.ptyId)
+    },
+    getCwd: (id) => Promise.resolve(connected.get(id)?.cwd ?? '~'),
+    getSize: (id) => Promise.resolve(connected.get(id)?.size ?? null),
+    onData: (listener) => {
+      dataListeners.add(listener)
+      return () => dataListeners.delete(listener)
+    },
+    onExit: (listener) => {
+      exitListeners.add(listener)
+      return () => exitListeners.delete(listener)
+    }
+  }
+}
diff --git a/src/renderer/src/wails/local-runtime.ts b/src/renderer/src/wails/local-runtime.ts
new file mode 100644
index 0000000..689ace9
--- /dev/null
+++ b/src/renderer/src/wails/local-runtime.ts
@@ -0,0 +1,139 @@
+import type { RuntimeRpcResponse } from '../../../shared/remote-runtime/rpc/runtime-rpc-envelope'
+import type { WebRuntimeClient } from '../web/runtime/client/web-runtime-client'
+import type { StoredWebRuntimeEnvironment } from '../web/pairing/web-runtime-environment'
+
+type SubscribeOptions = NonNullable<Parameters<WebRuntimeClient['subscribe']>[3]>
+type SubscriptionEvents = Parameters<WebRuntimeClient['subscribe']>[2]
+type NativeBridge = {
+  protocol: 1
+  platform: NodeJS.Platform
+  call: (method: string, params?: unknown, signal?: AbortSignal) => Promise<unknown>
+  subscribe: (
+    method: string,
+    params: unknown,
+    events: SubscriptionEvents,
+    signal?: AbortSignal
+  ) => Promise<() => void>
+}
+
+export function getWailsDesktopBridge(): NativeBridge | undefined {
+  const bridge = (globalThis as typeof globalThis & { __orcaWailsDesktop?: NativeBridge })
+    .__orcaWailsDesktop
+  return bridge?.protocol === 1 ? bridge : undefined
+}
+
+// The shared client adapters use a connection key for caches. This key is never
+// published to the host catalog or written as a pairing.
+export const localDesktopConnection: StoredWebRuntimeEnvironment = {
+  id: 'local',
+  name: 'This computer',
+  createdAt: 0,
+  updatedAt: 0,
+  lastUsedAt: null,
+  runtimeId: null,
+  preferredEndpointId: '',
+  endpoints: []
+}
+
+export type RuntimeConnectionClient = Pick<
+  WebRuntimeClient,
+  'call' | 'subscribe' | 'subscribeCrewAttempt' | 'connectionEpoch' | 'close' | 'statusOwner'
+>
+
+function linkAbortSignals(signals: AbortSignal[]): AbortController {
+  const controller = new AbortController()
+  for (const signal of signals) {
+    if (signal.aborted) {
+      controller.abort(signal.reason)
+      break
+    }
+    signal.addEventListener('abort', () => controller.abort(signal.reason), {
+      once: true,
+      signal: controller.signal
+    })
+  }
+  return controller
+}
+
+export function createLocalRuntimeClient(bridge: NativeBridge): RuntimeConnectionClient {
+  let runtimeId: string | undefined
+  let connectionEpoch = 0
+  const lifetime = new AbortController()
+
+  const call: RuntimeConnectionClient['call'] = async (method, params, options) => {
+    const signals = [lifetime.signal, AbortSignal.timeout(options?.timeoutMs ?? 30_000)]
+    if (options?.signal) signals.push(options.signal)
+    const controller = linkAbortSignals(signals)
+    const signal = controller.signal
+    try {
+      if (options?.expectedConnectionEpoch !== undefined) {
+        const proof = (await bridge.call(
+          'status.get',
+          undefined,
+          signal
+        )) as RuntimeRpcResponse<unknown>
+        if (
+          !proof.ok ||
+          proof._meta.runtimeId !== runtimeId ||
+          options.expectedConnectionEpoch !== connectionEpoch
+        ) {
+          throw new Error('The local Orca Core restarted. Retry the request.')
+        }
+      }
+      const result = (await bridge.call(method, params, signal)) as RuntimeRpcResponse<unknown>
+      if (result._meta?.runtimeId && result._meta.runtimeId !== runtimeId) {
+        runtimeId = result._meta.runtimeId
+        connectionEpoch += 1
+      }
+      return result
+    } finally {
+      controller.abort()
+    }
+  }
+
+  const subscribe: RuntimeConnectionClient['subscribe'] = async (
+    method: string,
+    params: unknown,
+    callbacks: SubscriptionEvents,
+    options?: SubscribeOptions
+  ) => {
+    options?.assertCurrent?.()
+    options?.beforeSend?.()
+    const controller = linkAbortSignals(options?.signal ? [lifetime.signal, options.signal] : [lifetime.signal])
+    let close: () => void
+    try {
+      close = await bridge.subscribe(method, params, {
+        ...callbacks,
+        onClose: () => {
+          controller.abort()
+          callbacks.onClose?.()
+        }
+      }, controller.signal)
+    } catch (error) {
+      controller.abort()
+      throw error
+    }
+    return {
+      unsubscribe: () => {
+        close()
+        controller.abort()
+      },
+      sendBinary: () => {
+        throw new Error('Binary streaming is unavailable over the Wails desktop channel.')
+      }
+    }
+  }
+
+  return {
+    call,
+    subscribe,
+    subscribeCrewAttempt: async (params, callbacks, options) => ({
+      ok: true,
+      value: await subscribe('orchestration.crewSubscribe', params, callbacks, options)
+    }),
+    get connectionEpoch() {
+      return connectionEpoch
+    },
+    close: () => lifetime.abort()
+  }
+}
