+function withComputerBackend(handler: CommandHandler): CommandHandler {
+  return async (ctx) => {
+    const backend = ctx.flags.has('backend')
+      ? getOptionalStringFlag(ctx.flags, 'backend')
+      : process.env.ORCA_COMPUTER_USE_BACKEND
+    if (backend === undefined && !ctx.flags.has('backend')) return handler(ctx)
+    if (backend !== 'cua' && backend !== 'cua-vm' && backend !== 'orca') {
+      throw new RuntimeClientError('invalid_argument', 'Computer Use backend must be cua, cua-vm, or orca')
+    }
+    const client = new Proxy(ctx.client, {
+      get(target, property) {
+        if (property === 'call') {
+          const call: typeof target.call = (method, params, options) => method.startsWith('computer.')
+            ? target.call(method.replace('computer.', 'computer.withBackend.'), { backend, params: params ?? {} }, options)
+            : target.call(method, params, options)
+          return call
+        }
+        const value = Reflect.get(target, property, target)
+        return typeof value === 'function' ? value.bind(target) : value
+      }
+    })
+    return handler({ ...ctx, client })
+  }
+}
+
+export const COMPUTER_HANDLERS = Object.fromEntries(
+  Object.entries(computerHandlers).map(([name, handler]) => [name, withComputerBackend(handler)])
+)
