diff --git a/src/renderer/src/components/bots/bot-team-pending.ts b/src/renderer/src/components/bots/bot-team-pending.ts
new file mode 100644
index 0000000..d09cbdd
--- /dev/null
+++ b/src/renderer/src/components/bots/bot-team-pending.ts
@@ -0,0 +1,30 @@
+import { BotTeamCreate } from '../../../../shared/bots/bot-team'
+
+export function readPendingBotTeam(key: string): BotTeamCreate | undefined {
+  try {
+    const raw = localStorage.getItem(key)
+    return raw ? BotTeamCreate.safeParse(JSON.parse(raw)).data : undefined
+  } catch {
+    return undefined
+  }
+}
+
+export function rememberPendingBotTeam(key: string | undefined, request: BotTeamCreate): void {
+  if (key) {
+    try {
+      localStorage.setItem(key, JSON.stringify(request))
+    } catch {
+      // The current dialog can still retry when storage is unavailable.
+    }
+  }
+}
+
+export function forgetPendingBotTeam(key: string | undefined, requestId: string): void {
+  if (key && readPendingBotTeam(key)?.requestId === requestId) {
+    try {
+      localStorage.removeItem(key)
+    } catch {
+      // A replay will pick up the existing group.
+    }
+  }
+}
