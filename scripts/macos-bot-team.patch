+      setCustomName('')
+      setGoal('')
+      setPreview(undefined)
+      setReviewing(false)
+      setCreationStarted(false)
+      setSavedRoleIds([])
+      setGroup(undefined)
+      setError(undefined)
+    }
+    onClose()
+  }
