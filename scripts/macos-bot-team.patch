+} from './bot-team-pending'
+import type { RuntimeStatus } from '../../../../shared/remote-runtime/session-graph/runtime-session-contracts'
+
+type Role = BotTeamGenerate['roles'][number]
+type DraftMember = BotTeamDraft['members'][number]
+
+export function NewBotTeamDialog({ open, onClose }: { open: boolean; onClose: () => void }) {
+  const t = useTranslate()
+  const locale = useIntlLocale()
+  const host = ownBotHost()
+  const [agentChoices, setAgentChoices] = useState<BotTeamAgent[]>()
+  const agents = agentChoices ?? []
+  const [agentPick, setAgentPick] = useState<BotTeamAgent>()
+  const agent = agentPick && agents.includes(agentPick) ? agentPick : agents[0]
+  const [selected, setSelected] = useState(['product', 'frontend', 'qa'])
+  const [customRoles, setCustomRoles] = useState<Role[]>([])
+  const [category, setCategory] = useState('all')
+  const [addingRole, setAddingRole] = useState(false)
+  const [customName, setCustomName] = useState('')
+  const [goal, setGoal] = useState('')
+  const [preview, setPreview] = useState<BotTeamCreate>()
+  const [reviewing, setReviewing] = useState(false)
+  const [creationStarted, setCreationStarted] = useState(false)
+  const [savedRoleIds, setSavedRoleIds] = useState<string[]>([])
+  const [recovering, setRecovering] = useState(false)
+  const recoveryKey = useRef<string | undefined>(undefined)
+  const [group, setGroup] = useState<BotGroup>()
+  const [busy, setBusy] = useState<'generate' | 'create'>()
+  const [error, setError] = useState<string>()
+  const running = useRef(false)
+  const groups = botTeamRoleGroups(t)
+  if (customRoles.length) {
+    groups.push({ id: 'custom', label: t('bots.team.custom', 'Custom'), roles: customRoles })
+  }
+  const roles = groups.flatMap((section) => section.roles)
+  const picked = roles.filter((role) => selected.includes(role.id))
+  const roleLabels = new Map(preview?.roles.map(({ id, label }) => [id, label]))
+  const visibleGroups = category === 'all' ? groups : groups.filter((item) => item.id === category)
+  const stage = group ? 2 : reviewing ? 1 : 0
+  const canCreate = preview !== undefined && BotTeamCreate.safeParse(preview).success
+  const steps = [
+    t('bots.team.chooseRoles', 'Choose roles'),
+    t('bots.team.review', 'Review draft'),
+    t('bots.team.done', 'Team created')
+  ]
+
+  useEffect(() => {
+    if (!open) {
+      return
+    }
+    let current = true
+    setRecovering(true)
+    setAgentChoices(undefined)
+    void callBotRpc<{ agents: string[] }>(ownBotHost(), 'bots.agentChoices')
+      .then(({ agents }) => {
+        if (current) {
+          setAgentChoices(
+            agents.filter((agent): agent is BotTeamAgent => agent === 'codex' || agent === 'claude')
+          )
+        }
+      })
+      .catch(() => {
+        if (current) {
+          setAgentChoices([])
+        }
+      })
+    void callBotRpc<RuntimeStatus>(ownBotHost(), 'status.get', {})
+      .then((status) => {
+        if (!current) {
+          return
+        }
+        const installation = status.hostDescriptor?.installationId
+        const key = installation ? 'orca.bot-team.pending.' + installation : undefined
+        const previous = recoveryKey.current
+        recoveryKey.current = key
+        const pending = key && readPendingBotTeam(key)
+        if (pending) {
+          setPreview(pending)
+          setReviewing(true)
+          setCreationStarted(true)
+          setSavedRoleIds([])
+        } else if (previous && key && previous !== key) {
+          setPreview(undefined)
+          setReviewing(false)
+          setCreationStarted(false)
+          setSavedRoleIds([])
+          setError(undefined)
+        }
+      })
+      .catch(() => {})
+      .finally(() => {
+        if (current) {
+          setRecovering(false)
+        }
+      })
+    return () => {
+      current = false
+    }
+  }, [open])
+
+  function changeSelection(id: string, checked: boolean) {
+    setSelected((current) =>
+      checked ? [...current, id] : current.filter((roleId) => roleId !== id)
+    )
+    setPreview(undefined)
+    setError(undefined)
+  }
+
+  function addRole(event: React.FormEvent) {
+    event.preventDefault()
+    const label = customName.trim()
+    if (!label) {
+      return
+    }
+    const existing = roles.find((role) => role.label.toLowerCase() === label.toLowerCase())
+    if (!existing || !selected.includes(existing.id)) {
+      const role = existing ?? { id: 'custom-' + createNonSecureContextUuid(), label }
+      if (!existing) {
+        setCustomRoles((current) => [...current, role])
+      }
+      changeSelection(role.id, true)
+    }
+    setCategory('all')
+    setAddingRole(false)
+    setCustomName('')
+  }
+
+  async function generate() {
+    if (!agent || !picked.length || recovering || running.current) {
+      return
+    }
+    setError(undefined)
+    if (preview) {
+      setReviewing(true)
+      return
+    }
+    const request = { requestId: createNonSecureContextUuid(), roles: picked, agent }
+    const input: BotTeamGenerate = {
+      ...request,
+      goal,
+      language: locale.startsWith('zh') ? 'zh' : 'en'
+    }
+    running.current = true
+    setBusy('generate')
+    try {
+      const { draft } = await callBotRpc<{ draft: BotTeamDraft }>(
+        host,
+        'bots.teams.generate',
+        input
+      )
+      setPreview({ ...request, draft })
+      setReviewing(true)
+    } catch {
+      setError(
+        t(
+          'bots.team.generateFailed',
+          'Could not generate the draft. Check the selected agent and try again.'
+        )
+      )
+    } finally {
+      running.current = false
+      setBusy(undefined)
+    }
+  }
+
+  function editMember(
+    roleId: string,
+    patch: Partial<Pick<DraftMember, 'name' | 'duty' | 'instructions'>>
+  ) {
+    setPreview(
+      (current) =>
+        current && {
+          ...current,
+          draft: {
+            ...current.draft,
+            members: current.draft.members.map((member) =>
+              member.roleId === roleId ? { ...member, ...patch } : member
+            )
+          }
+        }
+    )
+  }
+
+  async function create() {
+    if (!preview || !canCreate || running.current) {
+      return
+    }
+    running.current = true
+    setBusy('create')
+    setCreationStarted(true)
+    setError(undefined)
+    rememberPendingBotTeam(recoveryKey.current, preview)
+    try {
+      const result = await callBotRpc<BotTeamCreateResult>(host, 'bots.teams.create', preview)
+      if ('nameConflict' in result) {
+        setSavedRoleIds(result.savedRoleIds)
+        setCreationStarted(false)
+        if (!result.savedRoleIds.length) {
+          forgetPendingBotTeam(recoveryKey.current, preview.requestId)
+        }
+        setError(
+          t(
+            'bots.team.nameConflict',
+            'A Bot named “{{name}}” already exists. Change its name in the draft.',
+            { name: result.nameConflict }
+          )
+        )
+        return
+      }
+      setGroup(stampBotGroupHost(host.hostId, result.group))
+      forgetPendingBotTeam(recoveryKey.current, preview.requestId)
+      void Promise.allSettled([refreshBotHost(host.hostId), refreshBotHostGroups(host.hostId)])
+    } catch (cause) {
+      setError(botErrorMessage(cause))
+    } finally {
+      running.current = false
+      setBusy(undefined)
+    }
+  }
