+            <Button
+              className="sm:ml-auto"
+              onClick={() => {
+                close()
+                void openBotGroup(group).catch((cause: unknown) =>
+                  toast.error(botErrorMessage(cause))
+                )
+              }}
+            >
+              {t('bots.team.openGroup', 'Open group')}
+            </Button>
+          ) : null}
+        </DialogFooter>
+      </DialogContent>
+    </Dialog>
+  )
+}
