@@ -0,0 +1,17 @@
+import type { BotTeamNameConflict } from '../../shared/bots/bot-team'
+
+export async function assembleBotTeam<Group>(deps: {
+  findGroup: () => Group | undefined
+  createMembers: () => Promise<{ memberIds: string[] } | BotTeamNameConflict>
+  createGroup: (memberIds: string[]) => Promise<Group>
+}): Promise<{ group: Group } | BotTeamNameConflict> {
+  const existing = deps.findGroup()
+  if (existing) {
+    return { group: existing }
+  }
+  const members = await deps.createMembers()
+  if ('nameConflict' in members) {
+    return members
+  }
+  return { group: await deps.createGroup(members.memberIds) }
+}
