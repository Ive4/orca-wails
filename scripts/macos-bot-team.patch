+import { expect, test } from 'vitest'
+import { assembleBotTeam } from './bot-team-creation'
+
+test('a failed group write can finish and replay the same group', async () => {
+  let group: { id: string; members: string[] } | undefined
+  let failed = false
+  const deps = {
+    findGroup: () => group,
+    createMembers: async () => ({ memberIds: ['bot-1', 'bot-2'] }),
+    async createGroup(members: string[]) {
+      if (!failed) {
+        failed = true
+        throw new Error('Group storage unavailable')
+      }
+      group = { id: 'team-test', members }
+      return group
+    }
+  }
+
+  await expect(assembleBotTeam(deps)).rejects.toThrow('Group storage unavailable')
+  expect(await assembleBotTeam(deps)).toEqual({
+    group: { id: 'team-test', members: ['bot-1', 'bot-2'] }
+  })
+  expect(
+    await assembleBotTeam({
+      ...deps,
+      createGroup: async () => {
+        throw new Error('A saved group should be replayed')
+      }
+    })
+  ).toEqual({ group: { id: 'team-test', members: ['bot-1', 'bot-2'] } })
+})
