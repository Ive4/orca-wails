diff --git a/src/shared/bots/bot-team.test.ts b/src/shared/bots/bot-team.test.ts
new file mode 100644
index 0000000..3e49c3b
--- /dev/null
+++ b/src/shared/bots/bot-team.test.ts
@@ -0,0 +1,53 @@
+import { expect, test } from 'vitest'
+import { parseBotTeamDraft } from './bot-team'
+
+const roles = [
+  { id: 'frontend', label: 'Frontend engineer' },
+  { id: 'qa', label: 'QA engineer' }
+]
+const frontend = {
+  roleId: 'frontend',
+  name: 'Interface',
+  duty: 'Build the screen.',
+  instructions: 'Use the project’s UI conventions.',
+  handoff: 'Implementation and acceptance notes.'
+}
+const qa = {
+  roleId: 'qa',
+  name: 'Verifier',
+  duty: 'Verify the screen.',
+  instructions: 'Cover loading and empty states.',
+  handoff: null
+}
+
+test('decodes a fenced draft and keeps the model’s handoff order', () => {
+  const raw = '```json\n' + JSON.stringify({ name: 'Delivery', members: [frontend, qa] }) + '\n```'
+  expect(parseBotTeamDraft(raw, roles)).toEqual({ name: 'Delivery', members: [frontend, qa] })
+})
+
+test('refuses a draft that adds or drops a selected role', () => {
+  expect(() =>
+    parseBotTeamDraft(JSON.stringify({ name: 'Delivery', members: [qa] }), roles)
+  ).toThrow()
+  expect(() =>
+    parseBotTeamDraft(
+      JSON.stringify({
+        name: 'Delivery',
+        members: [{ ...frontend, roleId: 'ops' }, qa]
+      }),
+      roles
+    )
+  ).toThrow()
+})
+
+test('refuses duplicate bot names within a team', () => {
+  expect(() =>
+    parseBotTeamDraft(
+      JSON.stringify({
+        name: 'Delivery',
+        members: [frontend, { ...qa, name: 'INTERFACE' }]
+      }),
+      roles
+    )
+  ).toThrow()
+})
diff --git a/src/shared/bots/bot-team.ts b/src/shared/bots/bot-team.ts
new file mode 100644
index 0000000..31d5d54
--- /dev/null
+++ b/src/shared/bots/bot-team.ts
@@ -0,0 +1,89 @@
+import * as z from 'zod'
+import { BotNameSchema } from '../bot-types'
+import type { BotGroup } from './bot-group'
+
+export const BOT_TEAM_MAX = 32
+export const BOT_TEAM_ROLE_LABEL_MAX = 48
+export const BOT_TEAM_GOAL_MAX = 600
+export const BOT_TEAM_DUTY_MAX = 200
+export const BOT_TEAM_INSTRUCTIONS_MAX = 500
+
+const RoleId = z.string().regex(/^[a-z0-9-]{1,48}$/)
+const Roles = z
+  .array(
+    z.object({
+      id: RoleId,
+      label: z.string().trim().min(1).max(BOT_TEAM_ROLE_LABEL_MAX)
+    })
+  )
+  .min(1)
+  .max(BOT_TEAM_MAX)
+  .refine(
+    (roles) => new Set(roles.map((role) => role.id)).size === roles.length,
+    'Choose each role once.'
+  )
+export const BotTeamAgent = z.enum(['codex', 'claude'])
+
+export const BotTeamGenerate = z.object({
+  requestId: z.uuid(),
+  roles: Roles,
+  goal: z.string().trim().max(BOT_TEAM_GOAL_MAX),
+  agent: BotTeamAgent,
+  language: z.enum(['en', 'zh'])
+})
+
+const Member = z.object({
+  roleId: RoleId,
+  name: BotNameSchema,
+  duty: z.string().trim().min(1).max(BOT_TEAM_DUTY_MAX),
+  instructions: z.string().trim().min(1).max(BOT_TEAM_INSTRUCTIONS_MAX),
+  handoff: z.string().trim().min(1).max(120).nullable()
+})
+export const BotTeamDraft = z
+  .object({
+    name: BotNameSchema,
+    members: z.array(Member).min(1).max(BOT_TEAM_MAX)
+  })
+  .refine(
+    ({ members }) =>
+      new Set(members.map((member) => member.name.toLowerCase())).size === members.length,
+    'Give each bot a distinct name.'
+  )
+  .refine(
+    ({ members }) =>
+      members.every((member, i) => Boolean(member.handoff) === i < members.length - 1),
+    'Provide a handoff between consecutive members.'
+  )
+
+type Roles = z.infer<typeof Roles>
+
+function matchesRoles(draft: BotTeamDraft, roles: Roles): boolean {
+  const ids = new Set(roles.map((role) => role.id))
+  return (
+    draft.members.length === ids.size && draft.members.every((member) => ids.delete(member.roleId))
+  )
+}
+
+export function parseBotTeamDraft(raw: string, roles: Roles): BotTeamDraft {
+  const answer = raw.trim().replace(/^```(?:json)?\s*([\s\S]*?)\s*```$/i, '$1')
+  const draft = BotTeamDraft.parse(JSON.parse(answer))
+  if (!matchesRoles(draft, roles)) {
+    throw new Error('The draft must contain one bot for each selected role.')
+  }
+  return draft
+}
+
+export const BotTeamCreate = BotTeamGenerate.pick({ requestId: true, roles: true, agent: true })
+  .extend({ draft: BotTeamDraft })
+  .refine(
+    ({ draft, roles }) => matchesRoles(draft, roles),
+    'The members must match the selected roles.'
+  )
+
+export type BotTeamAgent = z.infer<typeof BotTeamAgent>
+export type BotTeamDraft = z.infer<typeof BotTeamDraft>
+export type BotTeamGenerate = z.infer<typeof BotTeamGenerate>
+export type BotTeamCreate = z.infer<typeof BotTeamCreate>
+
+export type BotTeamNameConflict = { nameConflict: string; savedRoleIds: string[] }
+export type BotTeamCreateResult = { group: BotGroup } | BotTeamNameConflict
