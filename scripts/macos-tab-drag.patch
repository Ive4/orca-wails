diff --git a/src/renderer/src/components/tab-group/drag/tab-drag-pointer-sensor.test.tsx b/src/renderer/src/components/tab-group/drag/tab-drag-pointer-sensor.test.tsx
new file mode 100644
--- /dev/null
+++ b/src/renderer/src/components/tab-group/drag/tab-drag-pointer-sensor.test.tsx
@@ -0,0 +1,107 @@
+// @vitest-environment happy-dom
+
+import { DndContext, useDraggable, useSensor } from '@dnd-kit/core'
+import { cleanup, fireEvent, render, screen } from '@testing-library/react'
+import { afterEach, expect, it, vi } from 'vitest'
+import { useTabStripPointerActivation } from '../../tab-bar/strip/tab-strip-pointer-activation'
+import { TAB_DRAG_ACTIVATION_DISTANCE_PX, TabDragPointerSensor } from './tab-drag-pointer-sensor'
+
+function Tab({ onActivate }: { onActivate: () => void }): React.JSX.Element {
+  const { attributes, listeners, setNodeRef } = useDraggable({ id: 'tab' })
+  const { onPointerDown } = useTabStripPointerActivation({ onActivate })
+  return (
+    <button
+      type="button"
+      ref={setNodeRef}
+      {...attributes}
+      onPointerDown={(event) => onPointerDown(event, listeners?.onPointerDown)}
+    >
+      Tab
+    </button>
+  )
+}
+
+function pressTab() {
+  const onActivate = vi.fn()
+  const onDragStart = vi.fn()
+  const onDragEnd = vi.fn()
+  function App(): React.JSX.Element {
+    const sensor = useSensor(TabDragPointerSensor, {
+      activationConstraint: { distance: TAB_DRAG_ACTIVATION_DISTANCE_PX }
+    })
+    return (
+      <DndContext sensors={[sensor]} onDragStart={onDragStart} onDragEnd={onDragEnd}>
+        <Tab onActivate={onActivate} />
+      </DndContext>
+    )
+  }
+
+  render(<App />)
+  fireEvent.pointerDown(screen.getByRole('button', { name: 'Tab' }), {
+    buttons: 1,
+    pointerId: 1,
+    isPrimary: true
+  })
+  return { onActivate, onDragStart, onDragEnd }
+}
+
+function movePointer(clientX: number, buttons: number, pointerId = 1): void {
+  fireEvent.pointerMove(document, { clientX, buttons, pointerId, isPrimary: true })
+}
+
+afterEach(() => {
+  fireEvent.pointerCancel(document, { pointerId: 1 })
+  cleanup()
+  vi.restoreAllMocks()
+})
+
+it('selects the tab on the first click when the WebView takes focus during the press', () => {
+  const hasFocus = vi.spyOn(document, 'hasFocus').mockReturnValue(false)
+  const { onActivate } = pressTab()
+  hasFocus.mockReturnValue(true)
+  fireEvent.focus(window)
+  fireEvent.pointerUp(document, { pointerId: 1, button: 0 })
+  expect(onActivate).toHaveBeenCalledOnce()
+})
+
+it('cancels tab selection when the window loses focus during the press', () => {
+  vi.spyOn(document, 'hasFocus').mockReturnValue(true)
+  const { onActivate } = pressTab()
+  fireEvent.blur(window)
+  fireEvent.focus(window)
+  fireEvent.pointerUp(document, { pointerId: 1, button: 0 })
+  expect(onActivate).not.toHaveBeenCalled()
+})
+
+it('selects the tab when the pointer slips a few pixels during a click', () => {
+  const { onActivate, onDragStart } = pressTab()
+  movePointer(14, 1)
+  movePointer(18, 1)
+  fireEvent.pointerUp(document, { clientX: 18, pointerId: 1, button: 0 })
+  expect(onDragStart).not.toHaveBeenCalled()
+  expect(onActivate).toHaveBeenCalledOnce()
+})
+
+it('does not start a drag from hover after a missed release', () => {
+  const { onDragStart } = pressTab()
+  movePointer(35, 0)
+  movePointer(45, 0)
+  expect(onDragStart).not.toHaveBeenCalled()
+})
+
+it('ignores movement from a pointer that did not press the tab', () => {
+  const { onDragStart } = pressTab()
+  movePointer(35, 1, 2)
+  movePointer(45, 1, 2)
+  expect(onDragStart).not.toHaveBeenCalled()
+})
+
+it('starts and finishes a deliberate drag with the primary button held', () => {
+  const { onActivate, onDragStart, onDragEnd } = pressTab()
+  movePointer(35, 1)
+  movePointer(45, 1)
+  fireEvent.pointerUp(document, { clientX: 45, pointerId: 1, button: 0 })
+  expect(onDragStart).toHaveBeenCalledOnce()
+  expect(onDragEnd).toHaveBeenCalledOnce()
+  expect(onActivate).not.toHaveBeenCalled()
+})
