new file mode 100644
index 00000000..9a4d0073
--- /dev/null
+++ b/src/cli/browser/browser-tab-control-status.test.ts
@@ -0,0 +1,45 @@
+import { afterEach, expect, it, vi } from 'vitest'
+
+const { callMock, runtimeClientConstructorMock, serveOrcaAppMock, getDefaultUserDataPathMock } =
+  vi.hoisted(() => ({
+    callMock: vi.fn(),
+    runtimeClientConstructorMock: vi.fn(),
+    serveOrcaAppMock: vi.fn(),
+    getDefaultUserDataPathMock: vi.fn(() => '/tmp/orca-user-data')
+  }))
+
+vi.mock('../runtime/client', async () => {
+  const { createRuntimeClientModuleMock } = await import('../index-test-harness.js')
+  return createRuntimeClientModuleMock({
+    callMock,
+    runtimeClientConstructorMock,
+    serveOrcaAppMock,
+    getDefaultUserDataPathMock
+  })
+})
+
+import { main } from '../index'
+import { okFixture } from '../runtime/fixtures/runtime-rpc-fixtures'
+
+afterEach(() => {
+  vi.restoreAllMocks()
+  process.exitCode = undefined
+})
+
+it('reads handoff status on the explicitly addressed browser page', async () => {
+  callMock.mockResolvedValue(
+    okFixture('req_page_control', { browserPageId: 'sign-in', state: 'held' })
+  )
+  const log = vi.spyOn(console, 'log').mockImplementation(() => {})
+
+  await main(['tab', 'control-status', '--page', 'sign-in', '--json'], '/tmp/test-workspace')
+
+  expect(callMock).toHaveBeenCalledWith('browser.pageControl', {
+    page: 'sign-in',
+    action: 'status'
+  })
+  expect(JSON.parse(log.mock.calls[0][0])).toMatchObject({
+    ok: true,
+    result: { browserPageId: 'sign-in', state: 'held' }
+  })
+})
