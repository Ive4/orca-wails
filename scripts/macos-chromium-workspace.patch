@@ -0,0 +1,45 @@
+import { getBrowserPageRuntimeEnvironmentId } from '../../../../../shared/browser/browser-page-runtime-owner'
+import type { BrowserPage } from '../../../../../shared/browser/workspaces/browser-workspace-types'
+import { FLOATING_TERMINAL_WORKTREE_ID } from '../../../../../shared/workspace/identity/floating-workspace-id'
+import {
+  resolveOwnerOrLocal,
+  runtimeEnvironmentIdOrLocalUnlessTwin
+} from '@/lib/workspace/ownership/worktree-runtime-owner'
+import { getWailsDesktopBridge, localDesktopConnection } from '@/wails/local-runtime'
+
+export function wailsChromiumDesktopEnvironmentId(): string | null {
+  return getWailsDesktopBridge()?.platform === 'darwin' ? localDesktopConnection.id : null
+}
+
+export function getWorkspaceBrowserEnvironmentId(
+  state: Parameters<typeof resolveOwnerOrLocal>[0],
+  worktreeId: string | null
+): string | null {
+  const runtime = runtimeEnvironmentIdOrLocalUnlessTwin(state, worktreeId)
+  const local = wailsChromiumDesktopEnvironmentId()
+  if (runtime || !local || !worktreeId || worktreeId === FLOATING_TERMINAL_WORKTREE_ID) {
+    return runtime
+  }
+  const workspace = resolveOwnerOrLocal(state, { workspaceId: worktreeId })
+  return workspace.kind === 'resolved' &&
+    workspace.owner.endpoint.kind === 'self' &&
+    workspace.owner.at === 'local'
+    ? local
+    : null
+}
+
+export function getWorkspaceBrowserPageEnvironmentId(
+  page: BrowserPage,
+  environmentId: string | null
+): string | null {
+  if (
+    environmentId &&
+    environmentId === wailsChromiumDesktopEnvironmentId() &&
+    !page.docLocation &&
+    !page.browserRuntimeEnvironmentId
+  ) {
+    // Reopen old local WebKit rows in Chromium when the user selects them.
+    return environmentId
+  }
+  return getBrowserPageRuntimeEnvironmentId(page, environmentId)
+}
