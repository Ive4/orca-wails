index 00000000..0f569e90
--- /dev/null
+++ b/src/renderer/src/components/browser-pane/stream-remote/use-wails-browser-tools.tsx
@@ -0,0 +1,226 @@
+import { useCallback, useEffect, useRef, useState } from 'react'
+import { callRuntimeRpc } from '@/runtime/rpc/calls/runtime-rpc-call'
+import { getFindRequestQuery } from '@/lib/text-search/find-query-bounds'
+import {
+  browserPageZoomLevelToFactor,
+  nextBrowserPageZoomLevel,
+  type BrowserPageZoomDirection
+} from '../../../../../shared/browser/site-settings/browser-page-zoom'
+import {
+  browserSiteDisplayKey,
+  type BrowserSiteColorScheme
+} from '../../../../../shared/browser/site-settings/browser-site-display'
+import { resolveRemoteFailureExternalUrl } from '../../../../../shared/browser/navigation/browser-url'
+import type {
+  BrowserPage,
+  BrowserViewportPresetId
+} from '../../../../../shared/browser/workspaces/browser-workspace-types'
+import { BrowserFindField } from '../assemble-chrome/find/BrowserFind'
+import type {
+  RemoteBrowserPaneNotice,
+  RemoteBrowserRuntimeTarget
+} from './remote-browser-page-input-model'
+
+type FindResult = { count: number; active: number }
+type FindRequest = 'start' | 'next' | 'previous' | 'clear'
+
+export type WailsBrowserTools = ReturnType<typeof useWailsBrowserTools>
+
+export function useWailsBrowserTools({
+  enabled,
+  worktreeId,
+  runtimeWorktree,
+  runtimeTarget,
+  remotePageId,
+  page,
+  setPaneNotice
+}: {
+  enabled: boolean
+  worktreeId: string
+  runtimeWorktree: string
+  runtimeTarget: () => RemoteBrowserRuntimeTarget | null
+  remotePageId: string | null
+  page: BrowserPage
+  setPaneNotice: (notice: RemoteBrowserPaneNotice | null) => void
+}) {
+  const site = browserSiteDisplayKey(page.url)
+  const [displayBySite, setDisplayBySite] = useState<
+    Record<string, { zoomLevel?: number; colorScheme?: BrowserSiteColorScheme }>
+  >({})
+  const [findOpen, setFindOpen] = useState(false)
+  const [viewportPresetId, setViewportPresetId] = useState<BrowserViewportPresetId | null>(null)
+  const display = site ? displayBySite[site] : undefined
+  const zoomLevel = display?.zoomLevel ?? 0
+  const colorScheme = display?.colorScheme ?? null
+  const callPage = useCallback(
+    (method: string, params: Record<string, unknown>): Promise<unknown> => {
+      const target = runtimeTarget()
+      if (!target || !remotePageId) {
+        return Promise.resolve(null)
+      }
+      return callRuntimeRpc(
+        target,
+        method,
+        { ...params, worktree: runtimeWorktree, page: remotePageId },
+        {
+          timeoutMs: 10_000,
+          suppressFeatureInteraction: true
+        }
+      )
+    },
+    [remotePageId, runtimeTarget, runtimeWorktree]
+  )
+  const reportError = useCallback(
+    (error: unknown): void => {
+      if (error instanceof Error) {
+        setPaneNotice({ kind: 'consequence', text: error.message })
+      }
+    },
+    [setPaneNotice]
+  )
+
+  useEffect(() => {
+    if (!enabled || !site || page.loading || !remotePageId) {
+      return
+    }
+    const factor = browserPageZoomLevelToFactor(zoomLevel)
+    void callPage('browser.eval', {
+      expression: `(() => {
+        const id = 'orca-wails-page-zoom';
+        let style = document.getElementById(id);
+        if (${factor} === 1) { style?.remove(); return; }
+        if (!style) {
+          style = document.createElement('style');
+          style.id = id;
+          document.documentElement.append(style);
+        }
+        style.textContent = 'html { zoom: ' + ${factor} + ' !important }';
+      })()`
+    }).catch(reportError)
+  }, [callPage, enabled, page.loading, page.url, remotePageId, reportError, site, zoomLevel])
+
+  useEffect(() => {
+    if (!enabled || !site || !remotePageId) {
+      return
+    }
+    const theme = document.documentElement.classList.contains('dark') ? 'dark' : 'light'
+    void callPage('browser.setMedia', { colorScheme: colorScheme ?? theme }).catch(reportError)
+  }, [callPage, colorScheme, enabled, remotePageId, reportError, site])
+
+  const openFind = useCallback(() => setFindOpen(true), [])
+  const closeFind = useCallback(() => setFindOpen(false), [])
+  const findOnPage = useCallback(
+    async (text: string, intent: FindRequest): Promise<FindResult | null> => {
+      const result = await callPage('browser.eval', {
+        expression: `(() => {
+        const query = ${JSON.stringify(text)};
+        const intent = ${JSON.stringify(intent)};
+        const selection = window.getSelection();
+        if (intent === 'start' || intent === 'clear') selection?.removeAllRanges();
+        if (!query || !document.body || !window.find(query, false, intent === 'previous', true)) return { count: 0, active: 0 };
+        const term = query.toLocaleLowerCase();
+        const countIn = (value) => value.toLocaleLowerCase().split(term).length - 1;
+        const count = Math.max(1, countIn(document.body.innerText));
+        if (!selection?.rangeCount) return { count, active: 1 };
+        const before = document.createRange();
+        before.selectNodeContents(document.body);
+        const match = selection.getRangeAt(0);
+        if (!document.body.contains(match.startContainer)) return { count, active: 1 };
+        before.setEnd(match.startContainer, match.startOffset);
+        return { count, active: Math.min(count, countIn(before.toString()) + 1) };
+      })()`
+      })
+      const found = (result as { result?: FindResult } | null)?.result
+      return found && Number.isInteger(found.count) && Number.isInteger(found.active) ? found : null
+    },
+    [callPage]
+  )
+
+  return {
+    worktreeId,
+    // The Wails host owns loopback URLs too, so its default browser can open them.
+    externalUrl:
+      site && /^https?:/.test(page.url) ? page.url : resolveRemoteFailureExternalUrl(page.url),
+    findOpen,
+    openFind,
+    closeFind,
+    findOnPage,
+    viewportPresetId,
+    setViewportPresetId,
+    siteDisplay: { site, zoomLevel, siteHasZoom: display?.zoomLevel !== undefined, colorScheme },
+    zoomPage(direction: BrowserPageZoomDirection): void {
+      if (site) {
+        setDisplayBySite((current) => ({
+          ...current,
+          [site]: {
+            ...current[site],
+            zoomLevel: nextBrowserPageZoomLevel(current[site]?.zoomLevel ?? 0, direction)
+          }
+        }))
+      }
+    },
+    setColorScheme(scheme: BrowserSiteColorScheme | null): void {
+      if (site) {
+        setDisplayBySite((current) => ({
+          ...current,
+          [site]: { ...current[site], colorScheme: scheme ?? undefined }
+        }))
+      }
+    }
+  }
+}
+
+export function WailsBrowserFind({
+  run,
+  onClose
+}: {
+  run: WailsBrowserTools['findOnPage']
+  onClose: () => void
+}): React.JSX.Element {
+  const inputRef = useRef<HTMLInputElement>(null)
+  const request = useRef(0)
+  const [query, setQuery] = useState('')
+  const [found, setFound] = useState<FindResult | null>(null)
+  const text = getFindRequestQuery(query) ?? ''
+  const search = useCallback(
+    (term: string, intent: FindRequest) => {
+      const current = ++request.current
+      void run(term, intent)
+        .then((result) => {
+          if (request.current === current) {
+            setFound(result)
+          }
+        })
+        .catch(() => {})
+    },
+    [run]
+  )
+
+  useEffect(() => {
+    inputRef.current?.focus()
+    return () => {
+      request.current += 1
+      void run('', 'clear').catch(() => {})
+    }
+  }, [run])
+
+  useEffect(() => {
+    request.current += 1
+    setFound(null)
+    const timer = setTimeout(() => search(text, text ? 'start' : 'clear'), 180)
+    return () => clearTimeout(timer)
+  }, [search, text])
+
+  return (
+    <BrowserFindField
+      inputRef={inputRef}
+      query={query}
+      setQuery={setQuery}
+      activeMatch={found?.active ?? 0}
+      totalMatches={found?.count ?? null}
+      onClose={onClose}
+      findPrevious={() => text && search(text, 'previous')}
+      findNext={() => text && search(text, 'next')}
+    />
+  )
+}
