+import { afterEach, expect, test, vi } from 'vitest'
+import { decodeBrowserScreencastFrame } from '../../../../shared/browser/screencast/browser-screencast-protocol'
+import { acknowledgeBrowserScreencastFrame } from '../../../runtime/browser/screencast/browser-screencast-frame-credit'
+import { startExternalChromiumScreencast } from './external-chromium-screencast'
+
+const tab = {
+  browserPageId: 'page-a',
+  index: 0,
+  url: 'https://example.com',
+  title: 'A',
+  active: true
+}
+
+afterEach(() => vi.useRealTimers())
+
+test('waits for ready, sends page-sized images, and stops capturing when unsubscribed', async () => {
+  vi.useFakeTimers()
+  const capture = vi.fn(async () => ({
+    image: Uint8Array.of(3),
+    width: 960,
+    height: 540
+  }))
+  const binary = vi.fn<(frame: Uint8Array<ArrayBufferLike>) => boolean>(() => true)
+  const result = startExternalChromiumScreencast(
+    tab,
+    { format: 'jpeg', frameAck: 1 },
+    { sendBinary: binary, pairedDeviceId: 'viewer' },
+    capture
+  )
+  expect(capture).not.toHaveBeenCalled()
+  expect(result.ready).toMatchObject({ browserPageId: 'page-a', frameAck: true, tab })
+  result.flushPendingFrame()
+  result.flushPendingFrame()
+  await vi.advanceTimersByTimeAsync(0)
+  expect(capture).toHaveBeenCalledTimes(1)
+  expect(decodeBrowserScreencastFrame(binary.mock.calls[0]![0])).toMatchObject({
+    seq: 1,
+    format: 'jpeg',
+    image: Uint8Array.of(3),
+    metadata: { deviceWidth: 960, deviceHeight: 540 }
+  })
+  await vi.advanceTimersByTimeAsync(600)
+  expect(binary).toHaveBeenCalledTimes(2)
+  expect(acknowledgeBrowserScreencastFrame(result.subscriptionId, 'other-viewer', 2)).toBe(false)
+  expect(acknowledgeBrowserScreencastFrame(result.subscriptionId, 'viewer', 2)).toBe(true)
+  result.session.stop()
+  await result.session.done
+  const captures = capture.mock.calls.length
+  await vi.advanceTimersByTimeAsync(2000)
+  expect(capture).toHaveBeenCalledTimes(captures)
+  expect(acknowledgeBrowserScreencastFrame(result.subscriptionId, 'viewer', 2)).toBe(false)
+})
+
+test('stopping during capture aborts it and discards a late frame', async () => {
+  let signal: AbortSignal | undefined
+  let finish!: (value: { image: Uint8Array; width: number; height: number }) => void
+  const capture = vi.fn((captureSignal: AbortSignal) => {
+    signal = captureSignal
+    return new Promise<Parameters<typeof finish>[0]>((resolve) => {
+      finish = resolve
+    })
+  })
+  const binary = vi.fn<(frame: Uint8Array<ArrayBufferLike>) => boolean>(() => true)
+  const result = startExternalChromiumScreencast(
+    tab,
+    { format: 'png' },
+    { sendBinary: binary },
+    capture
+  )
+  result.flushPendingFrame()
+  result.session.stop()
+  await result.session.done
+  expect(signal?.aborted).toBe(true)
+  finish({ image: Uint8Array.of(4), width: 320, height: 240 })
+  await Promise.resolve()
+  expect(binary).not.toHaveBeenCalled()
+})
