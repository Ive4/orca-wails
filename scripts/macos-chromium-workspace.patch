+it('keeps the human stream active and closes other streams when the page is taken', async () => {
+  vi.stubEnv('ORCA_WAILS_DESKTOP', '')
+  const { chromium, call, dispatcher } = setup()
+  await chromium.start()
+  expect(
+    await call('browser.tabCreate', { page: 'first', placement: { kind: 'server' } })
+  ).toMatchObject({
+    ok: true
+  })
+
+  function stream(deviceId: string) {
+    const controller = new AbortController()
+    const frame = Promise.withResolvers<void>()
+    const responses: RpcResponse[] = []
+    const finished = dispatcher.dispatchStreamingObjects(
+      {
+        id: `stream-${deviceId}`,
+        method: 'browser.screencast',
+        authToken: '',
+        params: { page: 'first', format: 'png' }
+      },
+      (response) => responses.push(response),
+      {
+        caller: { kind: 'paired-device', deviceId },
+        pairedDeviceId: deviceId,
+        connectionId: deviceId,
+        clientKind: 'runtime',
+        signal: controller.signal,
+        sendBinary: () => {
+          frame.resolve()
+          return true
+        }
+      }
+    )
+    return { frame: frame.promise, controller, finished, responses }
+  }
