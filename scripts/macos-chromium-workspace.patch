@@ -0,0 +1,66 @@
+import { BrowserError } from '../../../browser/browser-error'
+import {
+  isAgentRpcCaller,
+  type RpcCallerIdentity
+} from '../../../runtime/rpc/callers/rpc-caller-identity'
+import type { BrowserPageControlResult } from '../../../../shared/browser/runtime/runtime-browser-contracts'
+import type { ExternalChromiumPageRecord } from './external-chromium-tab-projection'
+
+function personKey(caller: RpcCallerIdentity | undefined): string | undefined {
+  if (caller?.kind === 'desktop') {
+    return 'desktop'
+  }
+  if (caller?.kind === 'paired-device' && !isAgentRpcCaller(caller)) {
+    return `paired-device:${caller.deviceId}`
+  }
+  return undefined
+}
+
+/** Shared by the command queue, stream captures and element selection for each live page. */
+export class ExternalChromiumPageControl {
+  private readonly owners = new WeakMap<ExternalChromiumPageRecord, string>()
+
+  assertCanUse(page: ExternalChromiumPageRecord, caller: RpcCallerIdentity | undefined): void {
+    if (this.canUse(page, caller)) {
+      return
+    }
+    throw new BrowserError(
+      'browser_page_manually_controlled',
+      'A person is controlling this browser page. Try again after they return control.',
+      { browserPageId: page.publicPageId, resume: 'after-release' }
+    )
+  }
+
+  isHeld(page: ExternalChromiumPageRecord): boolean {
+    return this.owners.has(page)
+  }
+
+  canUse(page: ExternalChromiumPageRecord, caller: RpcCallerIdentity | undefined): boolean {
+    const owner = this.owners.get(page)
+    return owner === undefined || owner === personKey(caller)
+  }
+
+  apply(
+    page: ExternalChromiumPageRecord,
+    action: unknown,
+    caller: RpcCallerIdentity | undefined
+  ): BrowserPageControlResult {
+    const person = personKey(caller)
+    if (action === 'take' || action === 'release') {
+      if (!person) {
+        throw new BrowserError('forbidden', 'Only a person can take or return browser control.')
+      }
+      this.assertCanUse(page, caller)
+      if (action === 'take') {
+        this.owners.set(page, person)
+      } else {
+        this.owners.delete(page)
+      }
+    }
+    const owner = this.owners.get(page)
+    return {
+      browserPageId: page.publicPageId,
+      state: owner === undefined ? 'available' : owner === person ? 'owned' : 'held'
+    }
+  }
+}
