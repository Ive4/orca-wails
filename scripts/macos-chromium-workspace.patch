+      expect.objectContaining({
+        ok: true,
+        result: expect.objectContaining({ type: 'ready', browserPageId: 'first' })
+      })
+    )
+  } finally {
+    ownerViewer.controller.abort()
+    await ownerViewer.finished
+  }
+})
