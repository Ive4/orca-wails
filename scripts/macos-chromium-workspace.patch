@@ -0,0 +1,111 @@
+import { randomUUID } from 'node:crypto'
+import type {
+  BrowserScreencastResult,
+  BrowserTabInfo
+} from '../../../../shared/browser/runtime/runtime-browser-contracts'
+import {
+  BrowserScreencastOpcode,
+  encodeBrowserScreencastFrame
+} from '../../../../shared/browser/screencast/browser-screencast-protocol'
+import type {
+  BrowserScreencastParams,
+  BrowserScreencastStartResult
+} from '../../../runtime/browser/screencast/browser-screencast-contracts'
+import { normalizeScreencastFrameBudget } from '../../../runtime/browser/screencast/browser-screencast-budget'
+import {
+  createBrowserScreencastFrameCredit,
+  registerBrowserScreencastFrameCredit
+} from '../../../runtime/browser/screencast/browser-screencast-frame-credit'
+import { mintBrowserScreencastSubscriptionId } from '../../../runtime/browser/screencast/browser-screencast-subscription-id'
+import { sendRemoteBrowserScreencastFrame } from '../../../runtime/browser/screencast/remote-browser-screencast-frame-admission'
+import type { RpcBinarySender } from '../../../runtime/rpc/transports/rpc-binary-sender'
+
+export type ChromiumCapture = { image: Uint8Array; width: number; height: number }
+
+export function startExternalChromiumScreencast(
+  tab: BrowserTabInfo,
+  params: BrowserScreencastParams,
+  stream: {
+    sendBinary: RpcBinarySender
+    emit?: (event: BrowserScreencastResult) => void
+    pairedDeviceId?: string
+  },
+  capture: (signal: AbortSignal) => Promise<ChromiumCapture>
+): BrowserScreencastStartResult {
+  const subscriptionId = mintBrowserScreencastSubscriptionId(tab.browserPageId, randomUUID())
+  const controller = new AbortController()
+  const budget = normalizeScreencastFrameBudget(params)
+  // Capture through the existing headless provider, yielding its command queue between frames.
+  const interval = Math.max(200, budget.minFrameIntervalMs)
+  let timer: ReturnType<typeof setTimeout> | undefined
+  let started = false
+  let seq = 0
+  let resolveDone!: () => void
+  const done = new Promise<void>((resolve) => {
+    resolveDone = resolve
+  })
+  const credit =
+    params.frameAck === 1
+      ? createBrowserScreencastFrameCredit({ onCreditAvailable: () => {} })
+      : undefined
+  const releaseCredit =
+    credit && registerBrowserScreencastFrameCredit(subscriptionId, stream.pairedDeviceId, credit)
+
+  const stop = (): void => {
+    if (controller.signal.aborted) return
+    controller.abort()
+    clearTimeout(timer)
+    releaseCredit?.()
+    resolveDone()
+  }
+  const tick = async (): Promise<void> => {
+    try {
+      if (!credit || credit.canSend()) {
+        const { image, width, height } = await capture(controller.signal)
+        if (controller.signal.aborted) return
+        const frame = encodeBrowserScreencastFrame({
+          opcode: BrowserScreencastOpcode.Frame,
+          seq: ++seq,
+          format: params.format,
+          metadata: { deviceWidth: width, deviceHeight: height },
+          image
+        })
+        const outcome = sendRemoteBrowserScreencastFrame(stream.sendBinary, frame)
+        if (outcome === 'handled') credit?.recordSent(seq)
+        if (outcome === 'dropped') {
+          stream.emit?.({ type: 'error', message: 'The browser frame is too large to stream.' })
+          stop()
+        }
+      }
+    } catch {
+      if (!controller.signal.aborted) {
+        stream.emit?.({
+          type: 'error',
+          message: 'The browser page is no longer available for streaming.'
+        })
+        stop()
+      }
+    } finally {
+      if (!controller.signal.aborted) timer = setTimeout(() => void tick(), interval)
+    }
+  }
+
+  return {
+    subscriptionId,
+    ready: {
+      type: 'ready',
+      subscriptionId,
+      browserPageId: tab.browserPageId,
+      format: params.format,
+      tab,
+      ...(credit ? { frameAck: true as const } : {})
+    },
+    // Keep the hosted viewport owned by the browser, independent of individual viewer sizes.
+    session: { done, stop, updateViewport: async () => {} },
+    flushPendingFrame: () => {
+      if (started || controller.signal.aborted) return
+      started = true
+      void tick()
+    }
+  }
+}
