+  expect(await call('browser.tabList', {})).toMatchObject({
+    ok: true,
+    result: {
+      tabs: [
+        { browserPageId: 'first', url: '', title: '' },
+        { browserPageId: 'second', url: 'about:blank', title: 'Second' }
+      ]
+    }
+  })
+  expect(await call('browser.tabClose', { index: 0 })).toMatchObject(held)
+  expect(await call('browser.pageControl', { ...first, action: 'release' }, other)).toMatchObject(
+    held
+  )
+  expect(
+    await call('browser.pageControl', { ...first, action: 'release' }, remoteAgent)
+  ).toMatchObject({
+    ok: false,
+    error: { code: 'forbidden' }
+  })
+  expect(await call('browser.snapshot', { page: 'second' })).toMatchObject({
+    ok: true,
+    result: { browserPageId: 'second', snapshot: 'content from driver-second' }
+  })
+  expect(
+    await call('browser.keyboardInsertText', { ...first, text: 'manual' }, owner)
+  ).toMatchObject({
+    ok: true
+  })
+  expect(await call('browser.pageControl', { ...first, action: 'release' }, owner)).toMatchObject({
+    ok: true,
+    result: { browserPageId: 'first', state: 'available' }
+  })
+  expect(await call('browser.pageControl', { ...first, action: 'status' })).toMatchObject({
+    ok: true,
+    result: { browserPageId: 'first', state: 'available' }
+  })
+  expect(await call('browser.snapshot', first)).toMatchObject({
+    ok: true,
+    result: { browserPageId: 'first', snapshot: 'content from driver-first' }
+  })
+})
