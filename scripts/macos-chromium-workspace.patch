+  LOCAL_CLI_RPC_CALLER,
+  type RpcCallerIdentity
+} from '../../../runtime/rpc/callers/rpc-caller-identity'
+import { RpcDispatcher } from '../../../runtime/rpc/dispatcher'
+import type { RpcResponse } from '../../../runtime/rpc/core'
+import { BROWSER_CORE_METHODS } from '../../../runtime/rpc/methods/browser/browser-core'
+import { BROWSER_SCREENCAST_METHODS } from '../../../runtime/rpc/methods/browser/browser-screencast'
+import { CLI_AGENT_CALLER_CLIENT_CAPABILITY } from '../../../../shared/remote-runtime/cli-agent-caller-capability'
+import { ExternalChromiumBrowserProcess } from './external-chromium-browser-process'
+import { ExternalChromiumBrowserSession } from './external-chromium-browser-session'
+
+const owner = { kind: 'paired-device', deviceId: 'wails-ui' } as const
+const other = { kind: 'paired-device', deviceId: 'other-ui' } as const
+const remoteAgent = { ...owner, agent: true } as const
+
+function setup() {
+  const clickStarted = Promise.withResolvers<void>()
+  const clickFinished = Promise.withResolvers<void>()
+  let active = 'driver-first'
+  const driverPages = [
+    { tabId: 'driver-first', url: 'about:blank', title: 'First' },
+    { tabId: 'driver-second', url: 'about:blank', title: 'Second' }
+  ]
+  vi.spyOn(ExternalChromiumBrowserSession.prototype, 'start').mockResolvedValue(active)
+  vi.spyOn(ExternalChromiumBrowserSession.prototype, 'readTabs').mockImplementation(async () =>
+    driverPages.map((page) => ({ ...page, active: page.tabId === active }))
+  )
+  vi.spyOn(ExternalChromiumBrowserSession.prototype, 'run').mockImplementation(async (args) => {
+    if (args[0] === 'open') {
+      return { url: 'about:blank', title: 'First' }
+    }
+    if (args[0] === 'tab' && args[1] === 'new') {
+      active = 'driver-second'
+      return { tabId: active }
+    }
+    if (args[0] === 'tab' && driverPages.some((page) => page.tabId === args[1])) {
+      active = args[1]
+      return {}
+    }
+    if (args[0] === 'snapshot') {
+      return { snapshot: `content from ${active}` }
+    }
+    if (args[0] === 'eval') {
+      return { result: { width: 1280, height: 720 } }
+    }
+    if (args[0] === 'keyboard' && args[1] === 'inserttext') {
+      return {}
+    }
+    if (args[0] === 'click') {
+      clickStarted.resolve()
+      await clickFinished.promise
+      return {}
+    }
+    throw new BrowserError('browser_error', `Unexpected driver command ${args.join(' ')}`)
+  })
+  vi.spyOn(ExternalChromiumBrowserSession.prototype, 'screenshot').mockResolvedValue({
+    data: Buffer.from('fixture frame').toString('base64'),
+    format: 'png'
+  })
+  const chromium = new ExternalChromiumBrowserProcess(
+    'test-agent-browser',
+    { executablePath: 'test-chromium', provider: 'chromium' },
+    'unused-test-state'
+  )
+  setRuntimeBrowserCommandsFactory((host) => chromium.createCommands(host), {
+    headless: true,
+    supportsPageControl: () => true,
+    isAvailable: () => chromium.isAvailable()
+  })
+  const runtime = new OrcaRuntimeService()
+  const dispatcher = new RpcDispatcher({
+    runtime,
+    methods: [...BROWSER_CORE_METHODS, ...BROWSER_SCREENCAST_METHODS]
+  })
+  function call(method: string, params: unknown, caller: RpcCallerIdentity = LOCAL_CLI_RPC_CALLER) {
+    return dispatcher.dispatch(
+      { id: method, method, params, authToken: '' },
+      caller.kind === 'paired-device'
+        ? {
+            pairedDeviceId: caller.deviceId,
+            clientKind: 'runtime',
+            clientCapabilities: caller.agent ? [CLI_AGENT_CALLER_CLIENT_CAPABILITY] : undefined
+          }
+        : { caller }
+    )
+  }
+  return { chromium, clickStarted, clickFinished, call, dispatcher }
+}
+
+afterEach(() => {
+  setRuntimeBrowserCommandsFactory(null)
+  vi.restoreAllMocks()
+  vi.unstubAllEnvs()
+})
