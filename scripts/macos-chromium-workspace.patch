+
+it('publishes a Core Chromium page in workspace tabs and closes it through its original provider', async () => {
+  const page: BrowserTabInfo = {
+    browserPageId: 'external-chromium-page',
+    worktreeId: TEST_WORKTREE_ID,
+    url: 'https://example.test/form',
+    title: 'Form',
+    active: true,
+    index: 0
+  }
+  let live = true
+  const close = vi.fn(async () => {
+    live = false
+    runtime.notifyMobileSessionTabsChanged(TEST_WORKTREE_ID)
+    return { closed: true }
+  })
+  setRuntimeBrowserCommandsFactory(
+    () =>
+      new Proxy({} as RuntimeBrowserCommands, {
+        get: (_target, name) => (name === 'browserTabClose' ? close : vi.fn())
+      }),
+    { listHostedTabs: (id: string) => (live && id === TEST_WORKTREE_ID ? [page] : []) }
+  )
+  const runtime = new OrcaRuntimeService({
+    ...store,
+    getWorkspaceSession: getDefaultWorkspaceSession
+  })
+  const selector = `id:${TEST_WORKTREE_ID}`
+  try {
+    runtime.notifyMobileSessionTabsChanged(TEST_WORKTREE_ID)
+    expect((await runtime.listMobileSessionTabs(selector)).tabs).toContainEqual(
