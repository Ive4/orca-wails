+// @vitest-environment happy-dom
+import { cleanup, createEvent, fireEvent, render } from '@testing-library/react'
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { getShortcutPlatform } from '@/lib/keyboard/shortcut-platform'
+import { callRuntimeRpc } from '@/runtime/rpc/calls/runtime-rpc-call'
+import { renderNavigation } from './remote-browser-page-navigation.test-fixture'
+import { RemoteBrowserInputQueue } from './remote-browser-input-queue'
+import { useRemoteBrowserPageKeyboard } from './use-remote-browser-page-keyboard'
+
+vi.mock('@/runtime/rpc/calls/runtime-rpc-call', () => ({ callRuntimeRpc: vi.fn() }))
+
+afterEach(() => {
+  cleanup()
+  vi.mocked(callRuntimeRpc).mockReset()
+})
+
+function renderKeyboard() {
+  const { lifecycle, tokens } = renderNavigation()
+  const queue = new RemoteBrowserInputQueue()
+  const Keyboard = ({ inputBlocked }: { inputBlocked: boolean }) => {
+    const { remoteKeyboardHandlers } = useRemoteBrowserPageKeyboard({
+      pickerAvailable: false,
+      inputBlocked,
+      runtimeTarget: () => ({ kind: 'environment', environmentId: 'environment-a' }),
+      lifecycle,
+      runtimeWorktree: 'worktree-a',
+      createRemoteOperationToken: (page) => tokens.createOperationToken(page),
+      isCurrentRemoteOperationToken: (token) => tokens.isCurrent(token),
+      enqueueRemoteInput: (operation) => queue.enqueue(operation),
+      closeMissingRemotePage: () => {},
+      scheduleRemoteTabInfoRefresh: () => {},
+      setPaneNotice: () => {}
+    })
+    return <textarea aria-label="Browser viewport" {...remoteKeyboardHandlers} />
+  }
+  const { getByRole, rerender } = render(<Keyboard inputBlocked={false} />)
+  return {
+    field: getByRole('textbox', { name: 'Browser viewport' }),
+    flush: () => queue.enqueue(async () => {}),
+    switchPage: () => tokens.setRemotePage('remote-page-b'),
+    setInputBlocked: (inputBlocked: boolean) => rerender(<Keyboard inputBlocked={inputBlocked} />)
+  }
+}
+
+const page = { worktree: 'worktree-a', page: 'remote-page-a' }
+
+function pageInputCalls() {
+  return vi.mocked(callRuntimeRpc).mock.calls.map(([, method, params]) => [method, params])
+}
+
+function commitComposition(field: HTMLElement, data: string) {
+  const event = createEvent.compositionEnd(field)
+  Object.defineProperty(event, 'data', { value: data })
+  fireEvent(field, event)
+}
+
+describe('streamed browser keyboard input', () => {
+  it('sends one Chinese IME commit and keeps candidate keys local', async () => {
+    const { field, flush } = renderKeyboard()
+    fireEvent.compositionStart(field)
+    fireEvent.keyDown(field, { key: 'n', isComposing: true })
+    fireEvent.compositionUpdate(field, { data: 'ni' })
+    fireEvent.keyDown(field, { key: 'ArrowDown' })
+    fireEvent.keyDown(field, { key: 'Enter', keyCode: 229 })
+    commitComposition(field, '你好')
+    fireEvent.input(field, { inputType: 'insertFromComposition', data: '你好' })
+    fireEvent.keyDown(field, { key: 'Enter' })
+    await flush()
+
+    expect(pageInputCalls()).toEqual([
+      ['browser.keyboardInsertText', { ...page, text: '你好' }],
+      ['browser.keypress', { ...page, key: 'Enter' }]
+    ])
+  })
+
+  it('drops a cancelled composition or one that belongs to a previous page', async () => {
+    const { field, flush, switchPage } = renderKeyboard()
+    fireEvent.compositionStart(field)
+    fireEvent.keyDown(field, { key: 'Escape' })
+    commitComposition(field, '')
+    await flush()
+    fireEvent.compositionStart(field)
+    switchPage()
+    commitComposition(field, '旧页面')
+    await flush()
+
+    expect(pageInputCalls()).toEqual([])
+  })
+
+  it('forwards local clipboard text in order with common keys', async () => {
+    const { field, flush } = renderKeyboard()
+    const isMac = getShortcutPlatform() === 'darwin'
+    fireEvent.keyDown(field, { key: 'A', shiftKey: true })
+    fireEvent.keyDown(field, { key: 'v', code: 'KeyV', metaKey: isMac, ctrlKey: !isMac })
+    fireEvent.paste(field, { clipboardData: { getData: () => '第一行\nsecond line' } })
+    fireEvent.keyDown(field, { key: 'Tab', shiftKey: true })
+    fireEvent.keyDown(field, { key: 'Backspace' })
+    fireEvent.keyDown(field, { key: 'Escape' })
+    await flush()
+
+    expect(pageInputCalls()).toEqual([
+      ['browser.keypress', { ...page, key: 'Shift+A' }],
+      ['browser.keyboardInsertText', { ...page, text: '第一行\nsecond line' }],
+      ['browser.keypress', { ...page, key: 'Shift+Tab' }],
+      ['browser.keypress', { ...page, key: 'Backspace' }],
+      ['browser.keypress', { ...page, key: 'Escape' }]
+    ])
+  })
+
+  it('inserts a native character outside a composition', async () => {
+    const { field, flush } = renderKeyboard()
+    fireEvent.keyDown(field, { key: 'é' })
+    fireEvent(field, new InputEvent('input', { bubbles: true, inputType: 'insertText', data: 'é' }))
+    await flush()
+
+    expect(pageInputCalls()).toEqual([['browser.keyboardInsertText', { ...page, text: 'é' }]])
+  })
+
+  it('drops keyboard input and pending composition across a control handoff', async () => {
+    const { field, flush, setInputBlocked } = renderKeyboard()
+    fireEvent.compositionStart(field)
+    setInputBlocked(true)
+    fireEvent.keyDown(field, { key: 'Enter' })
+    fireEvent.paste(field, { clipboardData: { getData: () => 'held paste' } })
+    setInputBlocked(false)
+    commitComposition(field, '未确认')
+    fireEvent.keyDown(field, { key: 'Tab' })
+    await flush()
+
+    expect(pageInputCalls()).toEqual([['browser.keypress', { ...page, key: 'Tab' }]])
+  })
+})
