+it('waits for an agent action, protects one page until its owner releases it, and resumes that page', async () => {
+  vi.stubEnv('ORCA_WAILS_DESKTOP', '')
+  const { chromium, clickStarted, clickFinished, call } = setup()
+  await chromium.start()
+  for (const page of ['first', 'second']) {
+    expect(await call('browser.tabCreate', { page, placement: { kind: 'server' } })).toMatchObject({
+      ok: true,
+      result: { browserPageId: page }
