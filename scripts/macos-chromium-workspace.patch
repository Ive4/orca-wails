+import type {
+  BrowserPageControlResult,
+  BrowserPageControlState
+} from '../../../../../shared/browser/runtime/runtime-browser-contracts'
+import type { BrowserPageGuestFocus } from '../assemble-chrome/focus/browser-page-guest-focus'
+import type {
+  RemoteBrowserPaneNotice,
+  RemoteBrowserRuntimeTarget
+} from './remote-browser-page-input-model'
+import type { RemoteBrowserInputQueue } from './remote-browser-input-queue'
+
+export type RemoteBrowserPageControl = {
+  state: BrowserPageControlState
+  pending: boolean
+  canTake: boolean
+  change(): void
+}
+
+export function useRemoteBrowserPageControl({
+  enabled,
+  isActive,
+  pageId,
+  worktree,
+  getTarget,
+  canTake,
+  inputQueue,
+  guestFocus,
+  setPaneNotice
+}: {
+  enabled: boolean
+  isActive: boolean
+  pageId: string | null
+  worktree: string
+  getTarget(): RemoteBrowserRuntimeTarget | null
+  canTake: boolean
+  inputQueue: RemoteBrowserInputQueue
+  guestFocus: BrowserPageGuestFocus
+  setPaneNotice(notice: RemoteBrowserPaneNotice | null): void
+}): RemoteBrowserPageControl | null {
+  const [answer, setAnswer] = useState<{ key: string; state: BrowserPageControlState } | null>(null)
+  const [pendingKey, setPendingKey] = useState<string | null>(null)
+  const activeScope = useRef<{ key: string; pending: boolean; version: number } | null>(null)
+  const environmentId = getTarget()?.environmentId
+  const supported = useRuntimeEnvironmentCapability(
+    enabled && pageId ? environmentId : null,
+    BROWSER_PAGE_CONTROL_RUNTIME_CAPABILITY
+  )
+  const key =
+    supported && isActive && environmentId && pageId
+      ? `${environmentId}\n${worktree}\n${pageId}`
+      : null
+
+  useEffect(() => {
+    if (!key || !environmentId || !pageId) {
+      return
+    }
+    const scope = { key, pending: false, version: 0 }
+    activeScope.current = scope
+    const controller = new AbortController()
+    let timer: ReturnType<typeof setTimeout> | undefined
+    const refresh = async (): Promise<void> => {
+      const version = scope.version
+      try {
+        if (scope.pending) {
+          return
+        }
+        const result = await callRuntimeRpc<BrowserPageControlResult>(
+          { kind: 'environment', environmentId },
+          'browser.pageControl',
+          { worktree, page: pageId, action: 'status' },
+          { signal: controller.signal, suppressFeatureInteraction: true }
+        )
+        if (activeScope.current === scope && scope.version === version) {
+          setAnswer({ key, state: result.state })
+        }
+      } catch {
+        // The stream reports connection failures. A later status read can recover the button.
+      } finally {
+        if (activeScope.current === scope) {
+          timer = setTimeout(() => void refresh(), 3_000)
+        }
+      }
+    }
+    void refresh()
+    return () => {
+      activeScope.current = null
+      controller.abort()
+      clearTimeout(timer)
+    }
+  }, [environmentId, key, pageId, worktree])
+
+  if (!key || !environmentId || !pageId || answer?.key !== key) {
+    return null
+  }
+
+  return {
+    state: answer.state,
+    pending: pendingKey === key,
+    canTake,
+    change: () => {
+      const scope = activeScope.current
+      if (scope?.key !== key || scope.pending || answer.state === 'held') {
+        return
+      }
+      const action = answer.state === 'owned' ? 'release' : 'take'
+      if (action === 'take' && !canTake) {
+        return
+      }
+      scope.pending = true
+      scope.version++
+      setPendingKey(key)
+      setPaneNotice(null)
+      // Send hand-back after any keystrokes or pointer input already queued for the page.
+      void inputQueue.enqueue(async () => {
+        try {
+          if (activeScope.current !== scope) {
+            return
+          }
+          const result = await callRuntimeRpc<BrowserPageControlResult>(
+            { kind: 'environment', environmentId },
+            'browser.pageControl',
+            { worktree, page: pageId, action },
+            { timeoutMs: 120_000, suppressFeatureInteraction: true }
+          )
+          if (activeScope.current === scope) {
+            setAnswer({ key, state: result.state })
+            if (action === 'take' && result.state === 'owned') {
+              guestFocus.focus()
+            }
+          }
+        } catch (error) {
+          if (activeScope.current === scope) {
+            setPaneNotice({
+              kind: 'direct',
+              text: error instanceof Error ? error.message : String(error)
+            })
+          }
+        } finally {
+          scope.pending = false
+          setPendingKey((current) => (current === key ? null : current))
+        }
+      })
+    }
+  }
+}
