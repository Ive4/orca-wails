diff --git a/src/main/orcad/browser-providers/chromium/external-chromium-grab.ts b/src/main/orcad/browser-providers/chromium/external-chromium-grab.ts
new file mode 100644
index 00000000..94c94425
--- /dev/null
+++ b/src/main/orcad/browser-providers/chromium/external-chromium-grab.ts
@@ -0,0 +1,273 @@
+import { randomUUID } from 'node:crypto'
+import { captureExternalChromiumSelection } from './external-chromium-grab-screenshot'
+import { setTimeout as delay } from 'node:timers/promises'
+import { z } from 'zod'
+import { BrowserError } from '../../../browser/browser-error'
+import { clampGrabPayload } from '../../../browser/element-grab/browser-grab-payload'
+import { buildGuestOverlayScript } from '../../../browser/element-grab/grab-guest-script'
+import type { RuntimeBrowserCommands } from '../../../runtime/browser/commands/browser-commands'
+import {
+  buildBrowserAnnotationViewportBridgeScript,
+  type BrowserAnnotationViewportBridgeOptions
+} from '../../../../shared/browser/annotations/browser-annotation-viewport-bridge'
+import { isBrowserGuestViewportMessage } from '../../../../shared/browser/annotations/browser-guest-document-event'
+import type { BrowserGrabResult } from '../../../../shared/browser/element-grab/browser-grab-types'
+import { redactKagiSessionToken } from '../../../../shared/browser/navigation/browser-url'
+import {
+  agentBrowserEvalCommand,
+  type ExternalChromiumBrowserSession
+} from './external-chromium-browser-session'
+
+const methods = [
+  'browserGrabSetMode',
+  'browserGrabAwait',
+  'browserGrabCancel',
+  'browserGrabCaptureSelection',
+  'browserGrabExtractHover',
+  'browserGrabViewportBridge',
+  'browserGrabWatch'
+] as const
+type GrabMethod = (typeof methods)[number]
+type Session = Pick<ExternalChromiumBrowserSession, 'run' | 'screenshot'>
+type OnPage = <T>(operation: (session: Session) => Promise<T>, signal?: AbortSignal) => Promise<T>
+
+const GRAB_STATE = 'globalThis.__orcaChromiumGrab'
+const POLL_MS = 350
+const EVAL_TIMEOUT_MS = 5_000
+const EvalResult = z.object({ result: z.unknown() })
+const Selection = z.object({ selection: z.unknown().optional(), failed: z.boolean().optional() })
+const DocumentState = z.object({
+  id: z.string(),
+  url: z.string(),
+  ready: z.boolean(),
+  report: z.unknown()
+})
+
+export function isExternalChromiumGrabMethod(method: string): method is GrabMethod {
+  return methods.some((candidate) => candidate === method)
+}
+
+async function evaluate(session: Session, script: string, signal?: AbortSignal): Promise<unknown> {
+  return EvalResult.parse(
+    await session.run(agentBrowserEvalCommand(script), { timeoutMs: EVAL_TIMEOUT_MS, signal })
+  ).result
+}
+
+export async function teardownExternalChromiumGrab(session: Session): Promise<void> {
+  await evaluate(
+    session,
+    `(() => { delete ${GRAB_STATE}; return ${buildGuestOverlayScript('teardown')}; })()`
+  )
+}
+
+export async function waitForExternalChromiumGrab(
+  opId: string,
+  read: () => Promise<unknown>,
+  abort?: AbortSignal
+): Promise<BrowserGrabResult> {
+  const timeout = AbortSignal.timeout(120_000)
+  const signal = abort ? AbortSignal.any([abort, timeout]) : timeout
+  try {
+    while (!signal.aborted) {
+      const state = Selection.nullable().parse(await read())
+      signal.throwIfAborted()
+      if (!state) {
+        return { opId, kind: 'cancelled', reason: 'navigation' }
+      }
+      if (state.failed) {
+        return { opId, kind: 'error', reason: 'Could not select this element' }
+      }
+      const selection = state.selection
+      if (selection && typeof selection === 'object') {
+        if ('__orcaCancelled' in selection) {
+          return { opId, kind: 'cancelled', reason: 'user' }
+        }
+        const viaContextMenu =
+          '__orcaContextMenu' in selection && selection.__orcaContextMenu === true
+        const payload = clampGrabPayload(
+          viaContextMenu && 'payload' in selection ? selection.payload : selection
+        )
+        return payload
+          ? { opId, kind: viaContextMenu ? 'context-selected' : 'selected', payload }
+          : { opId, kind: 'error', reason: 'The selected element is unavailable' }
+      }
+      await delay(POLL_MS, undefined, { signal })
+    }
+  } catch (error) {
+    if (!signal.aborted) {
+      throw error
+    }
+  }
+  return { opId, kind: 'cancelled', reason: abort?.aborted ? 'user' : 'timeout' }
+}
+
+async function watchDocument(
+  onPage: OnPage,
+  emit: Parameters<RuntimeBrowserCommands['browserGrabWatch']>[1],
+  signal?: AbortSignal
+): Promise<void> {
+  let previous: z.output<typeof DocumentState> | undefined
+  while (!signal?.aborted) {
+    try {
+      const next = DocumentState.parse(
+        await onPage(
+          (session) =>
+            evaluate(
+              session,
+              `({
+              id: globalThis.__orcaChromiumDocument ??= ${JSON.stringify(randomUUID())},
+              url: location.href,
+              ready: document.readyState !== 'loading',
+              report: globalThis.__orcaBrowserAnnotationViewportBridge?.latestReport ?? null
+            })`,
+              signal
+            ),
+          signal
+        )
+      )
+      if (signal?.aborted) {
+        return
+      }
+      const newDocument = next.id !== previous?.id
+      if (previous && newDocument) {
+        emit({ type: 'documentStart' })
+      }
+      if (newDocument || next.url !== previous?.url) {
+        emit({ type: 'navigated', url: redactKagiSessionToken(next.url) })
+      }
+      if (next.ready && (newDocument || !previous?.ready)) {
+        emit({ type: 'domReady' })
+      }
+      if (next.report !== previous?.report && isBrowserGuestViewportMessage(next.report)) {
+        emit({ type: 'viewport', message: next.report })
+      }
+      previous = next
+    } catch (error) {
+      if (signal?.aborted) {
+        return
+      }
+      if (
+        !(error instanceof BrowserError) ||
+        !['browser_eval_error', 'browser_navigation_failed', 'browser_timeout'].includes(error.code)
+      ) {
+        throw error
+      }
+    }
+    await delay(POLL_MS, undefined, { signal }).catch((error: unknown) => {
+      if (!signal?.aborted) {
+        throw error
+      }
+    })
+  }
+}
+
+export async function runExternalChromiumGrab(
+  method: GrabMethod,
+  args: unknown[],
+  onPage: OnPage
+): Promise<unknown> {
+  switch (method) {
+    case 'browserGrabSetMode': {
+      const [{ enabled }] = args as Parameters<RuntimeBrowserCommands['browserGrabSetMode']>
+      if (!enabled) {
+        await onPage(teardownExternalChromiumGrab)
+        return { ok: true }
+      }
+      const sessionId = JSON.stringify(randomUUID())
+      const armed = await onPage((session) =>
+        evaluate(
+          session,
+          `(() => {
+            ${buildGuestOverlayScript('teardown')};
+            if (!${buildGuestOverlayScript('arm')}) return false;
+            const state = ${GRAB_STATE} = { id: ${sessionId} };
+            ${buildGuestOverlayScript('awaitClick')}.then(
+              (selection) => { state.selection = selection; },
+              () => { state.failed = true; }
+            );
+            return true;
+          })()`
+        )
+      )
+      return armed === true ? { ok: true } : { ok: false, reason: 'injection-failed' }
+    }
+    case 'browserGrabAwait': {
+      const [{ opId }, signal] = args as Parameters<RuntimeBrowserCommands['browserGrabAwait']>
+      if (signal?.aborted) {
+        return { opId, kind: 'cancelled', reason: 'user' }
+      }
+      const generation = await onPage(
+        (session) => evaluate(session, `${GRAB_STATE}?.id ?? null`, signal),
+        signal
+      )
+      if (typeof generation !== 'string') {
+        return { opId, kind: 'error', reason: 'The element picker is unavailable' }
+      }
+      let selected = false
+      try {
+        const result = await waitForExternalChromiumGrab(
+          opId,
+          () =>
+            onPage(
+              (session) =>
+                evaluate(
+                  session,
+                  `${GRAB_STATE}?.id === ${JSON.stringify(generation)} ? ${GRAB_STATE} : null`,
+                  signal
+                ),
+              signal
+            ),
+          signal
+        )
+        selected = result.kind === 'selected' || result.kind === 'context-selected'
+        return result
+      } finally {
+        if (!selected) {
+          // The current document may already have been armed again.
+          await onPage((session) =>
+            evaluate(
+              session,
+              `(() => {
+              if (${GRAB_STATE}?.id !== ${JSON.stringify(generation)}) return false;
+              delete ${GRAB_STATE};
+              return ${buildGuestOverlayScript('teardown')};
+            })()`
+            )
+          ).catch(() => {})
+        }
+      }
+    }
+    case 'browserGrabCancel':
+      await onPage(teardownExternalChromiumGrab)
+      return { cancelled: true }
+    case 'browserGrabCaptureSelection': {
+      const [{ rect }] = args as Parameters<RuntimeBrowserCommands['browserGrabCaptureSelection']>
+      return onPage((session) =>
+        captureExternalChromiumSelection(
+          rect,
+          (script) => evaluate(session, script),
+          (...args) => session.screenshot(...args)
+        )
+      )
+    }
+    case 'browserGrabExtractHover': {
+      const payload = clampGrabPayload(
+        await onPage((session) => evaluate(session, buildGuestOverlayScript('extractHover')))
+      )
+      return payload ? { ok: true, payload } : { ok: false, reason: 'No element hovered' }
+    }
+    case 'browserGrabViewportBridge': {
+      const [options] = args as [BrowserAnnotationViewportBridgeOptions]
+      return {
+        applied:
+          (await onPage((session) =>
+            evaluate(session, buildBrowserAnnotationViewportBridgeScript(options, 'poll'))
+          )) === true
+      }
+    }
+    case 'browserGrabWatch': {
+      const [, emit, signal] = args as Parameters<RuntimeBrowserCommands['browserGrabWatch']>
+      return watchDocument(onPage, emit, signal)
+    }
+  }
+}
diff --git a/src/main/orcad/browser-providers/chromium/external-chromium-page-commands.ts b/src/main/orcad/browser-providers/chromium/external-chromium-page-commands.ts
