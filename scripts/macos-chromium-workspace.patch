+import { describe, expect, it } from 'vitest'
+import { waitForExternalChromiumGrab } from './external-chromium-grab'
+
+describe('the Chromium element picker', () => {
+  it('returns a picked DOM element as a sanitized annotation payload', async () => {
+    const result = await waitForExternalChromiumGrab('pick', async () => ({
+      selection: {
+        __orcaContextMenu: true,
+        payload: {
+          page: { sanitizedUrl: 'https://user:pass@example.test/shop?session=secret#private' },
+          target: {
+            tagName: 'button',
+            selector: '#checkout',
+            textSnippet: 'Checkout',
+            rectViewport: { x: 12, y: 25, width: 80, height: 32 }
+          }
+        }
+      }
+    }))
+
+    expect(result).toMatchObject({
+      opId: 'pick',
+      kind: 'context-selected',
+      payload: {
+        page: { sanitizedUrl: 'https://example.test/shop' },
+        target: { selector: '#checkout', textSnippet: 'Checkout' },
+        screenshot: null
+      }
+    })
+  })
+
+  it('cancels when navigation replaces the document that was armed', async () => {
+    expect(await waitForExternalChromiumGrab('pick', async () => null)).toEqual({
+      opId: 'pick',
+      kind: 'cancelled',
+      reason: 'navigation'
+    })
+  })
