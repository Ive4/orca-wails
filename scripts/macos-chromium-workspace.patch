@@ -0,0 +1,79 @@
+import { useEffect } from 'react'
+import { useAppStore } from '@/store/index'
+import {
+  getWorkspaceBrowserEnvironmentId,
+  wailsChromiumDesktopEnvironmentId
+} from '@/lib/browser/workspace/workspace-browser-environment'
+import type { RuntimeMobileSessionTabsResult } from '../../../../../shared/remote-runtime/session-graph/runtime-session-contracts'
+import { nextReceivedSessionTabsFrame } from '../../web-session-tabs-sync/state'
+import { applyWebRuntimeSessionTabsAnswer } from '../../web-session-tabs-sync/inventory/web-runtime-session-snapshot'
+import { toRuntimeWorktreeSelector } from '../../rpc/targets/runtime-worktree-selector'
+
+export function useWailsChromiumTabs(): void {
+  const environmentId = wailsChromiumDesktopEnvironmentId()
+  const worktreeId = useAppStore((state) => state.activeWorktreeId)
+  const ready = useAppStore((state) => state.workspaceSessionReady)
+  const local = useAppStore(
+    (state) => getWorkspaceBrowserEnvironmentId(state, state.activeWorktreeId) === environmentId
+  )
+  useEffect(() => {
+    if (!environmentId || !worktreeId || !ready || !local) {
+      return
+    }
+    let disposed = false
+    let stop: (() => void) | undefined
+    let retry: ReturnType<typeof setTimeout> | undefined
+    const connect = (): void => {
+      const reconnect = (): void => {
+        if (!disposed && retry === undefined) {
+          retry = setTimeout(() => {
+            retry = undefined
+            connect()
+          }, 2_000)
+        }
+      }
+      void window.api.runtimeEnvironments
+        .subscribe(
+          {
+            selector: environmentId,
+            method: 'session.tabs.subscribe',
+            params: { worktree: toRuntimeWorktreeSelector(worktreeId) }
+          },
+          {
+            onResponse: (response) => {
+              if (!response.ok) {
+                return
+              }
+              const event = response.result as RuntimeMobileSessionTabsResult & { type?: string }
+              if (event.type === 'snapshot' || event.type === 'updated') {
+                void applyWebRuntimeSessionTabsAnswer(
+                  environmentId,
+                  worktreeId,
+                  {
+                    snapshot: event,
+                    receivedFrame: nextReceivedSessionTabsFrame(),
+                    runtimeId: response._meta.runtimeId
+                  },
+                  { isCurrent: () => !disposed }
+                )
+              }
+            },
+            onClose: reconnect
+          }
+        )
+        .then(({ unsubscribe }) => {
+          if (disposed) {
+            unsubscribe()
+            return
+          }
+          stop = unsubscribe
+        }, reconnect)
+    }
+    connect()
+    return () => {
+      disposed = true
+      clearTimeout(retry)
+      stop?.()
+    }
+  }, [environmentId, worktreeId, ready, local])
+}
