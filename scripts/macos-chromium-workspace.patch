@@ -0,0 +1,77 @@
+import { randomUUID } from 'node:crypto'
+import { z } from 'zod'
+import {
+  GRAB_BUDGET,
+  type BrowserCaptureSelectionScreenshotResult,
+  type BrowserGrabRect
+} from '../../../../shared/browser/element-grab/browser-grab-types'
+import type { ExternalChromiumBrowserSession } from './external-chromium-browser-session'
+
+const CAPTURE_TIMEOUT_MS = 5_000
+const CaptureExtent = z.object({ width: z.number().positive(), height: z.number().positive() })
+
+export async function captureExternalChromiumSelection(
+  rect: BrowserGrabRect,
+  evaluate: (script: string) => Promise<unknown>,
+  screenshot: ExternalChromiumBrowserSession['screenshot']
+): Promise<BrowserCaptureSelectionScreenshotResult> {
+  const key = `orca-${randomUUID()}`
+  const selector = `[data-orca-grab-capture="${key}"]`
+  const state = `globalThis[${JSON.stringify(key)}]`
+  try {
+    const extent = CaptureExtent.safeParse(
+      await evaluate(
+        `(() => {
+          if (!globalThis.__orcaGrab) return null;
+          const { x, y, width, height } = ${JSON.stringify(rect)};
+          const left = Math.max(x, 0);
+          const top = Math.max(y, 0);
+          const w = Math.min(x + width, innerWidth) - left;
+          const h = Math.min(y + height, innerHeight) - top;
+          if (!(w > 0 && h > 0)) return null;
+          const marker = document.createElement('div');
+          marker.setAttribute('data-orca-grab-capture', ${JSON.stringify(key)});
+          marker.style.cssText = 'all:initial!important;display:block!important;position:fixed!important;'
+            + 'pointer-events:none!important;left:' + left + 'px!important;top:' + top
+            + 'px!important;width:' + w + 'px!important;height:' + h + 'px!important;';
+          const overlays = [globalThis.__orcaGrab?.host, ...document.querySelectorAll('[data-orca-browser-annotation-overlay]')];
+          ${state} = { marker, hidden: overlays.filter(Boolean).map(node => ({
+            node, display: node.style.getPropertyValue('display'), priority: node.style.getPropertyPriority('display')
+          })) };
+          ${state}.hidden.forEach(({ node }) => node.style.setProperty('display', 'none', 'important'));
+          document.documentElement.append(marker);
+          return { width: w, height: h };
+        })()`
+      )
+    )
+    if (extent.success) {
+      const { data } = await screenshot({ format: 'png' }, false, {
+        selector,
+        timeoutMs: CAPTURE_TIMEOUT_MS
+      })
+      if (data && Buffer.byteLength(data, 'base64') <= GRAB_BUDGET.screenshotMaxBytes) {
+        return {
+          ok: true,
+          screenshot: {
+            mimeType: 'image/png',
+            dataUrl: `data:image/png;base64,${data}`,
+            ...extent.data
+          }
+        }
+      }
+    }
+  } finally {
+    await evaluate(
+      `(() => {
+        const saved = ${state};
+        if (!saved) return false;
+        saved.marker.remove();
+        saved.hidden.forEach(({ node, display, priority }) =>
+          node.style.setProperty('display', display, priority));
+        delete ${state};
+        return true;
+      })()`
+    ).catch(() => {})
+  }
+  return { ok: false, reason: 'Screenshot capture failed' }
+}
