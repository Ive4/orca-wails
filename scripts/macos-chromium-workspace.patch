+  }
+
+  const first = { page: 'first' }
+  const completed: string[] = []
+  const runningClick = call('browser.click', { ...first, element: '#continue' })
+  await clickStarted.promise
+  const take = call('browser.pageControl', { ...first, action: 'take' }, owner).then((result) => {
+    completed.push('take')
+    return result
+  })
+  const queuedSnapshot = call('browser.snapshot', first)
+  void runningClick.then(() => completed.push('click'))
+  clickFinished.resolve()
+  expect(await runningClick).toMatchObject({ ok: true })
+  expect(await take).toMatchObject({ ok: true, result: { browserPageId: 'first', state: 'owned' } })
+  expect(completed).toEqual(['click', 'take'])
+  const held = {
+    ok: false,
+    error: {
+      code: 'browser_page_manually_controlled',
+      data: { browserPageId: 'first', resume: 'after-release' }
+    }
+  }
+  expect(await queuedSnapshot).toMatchObject(held)
+  expect(await call('browser.pageControl', { ...first, action: 'status' })).toMatchObject({
+    ok: true,
+    result: { browserPageId: 'first', state: 'held' }
+  })
