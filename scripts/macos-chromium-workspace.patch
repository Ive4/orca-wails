+  await otherViewer.finished
+  expect(otherViewer.responses).toContainEqual(
+    expect.objectContaining({
+      ok: true,
+      result: expect.objectContaining({ type: 'error' })
+    })
+  )
+
+  const ownerViewer = stream(owner.deviceId)
+  try {
+    await ownerViewer.frame
