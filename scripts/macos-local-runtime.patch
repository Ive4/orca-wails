diff --git a/src/renderer/src/runtime/hosts/display/wails-local-runtime.ts b/src/renderer/src/runtime/hosts/display/wails-local-runtime.ts
new file mode 100644
index 0000000..b570ca0
--- /dev/null
+++ b/src/renderer/src/runtime/hosts/display/wails-local-runtime.ts
@@ -0,0 +1,19 @@
+import { requireActiveEnvironmentOrNull } from '@/web/runtime/client/web-runtime-session'
+import type { StoredWebRuntimeEnvironment } from '@/web/pairing/web-runtime-environment'
+
+export function getWailsLocalRuntimeId(): string | null {
+  const owns = (
+    globalThis as {
+      __orcaWailsOwnsRuntime?: (environment: StoredWebRuntimeEnvironment) => boolean
+    }
+  ).__orcaWailsOwnsRuntime
+  if (!owns) {
+    return null
+  }
+  const environment = requireActiveEnvironmentOrNull()
+  return environment && owns(environment) ? environment.id : null
+}
+
+export function isWailsLocalRuntime(environmentId: string | null | undefined): boolean {
+  return !!environmentId && environmentId === getWailsLocalRuntimeId()
+}
