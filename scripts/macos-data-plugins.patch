+  return (
+    hostname === '127.0.0.1' &&
+    protocol === 'http:' &&
+    !!endpoints?.length &&
+    endpoints.every(({ endpoint }) => endpoint === `ws://${host}` || endpoint === `ws://${host}/`)
+  )
+}
+
+async function call<T>(operation: string, params?: unknown, timeout = 10_000): Promise<T> {
+  if (!hasLocalPairing()) {
+    throw new Error('The local Orca pairing is unavailable.')
+  }
+  return callRuntimeResult<T>(`dataPlugins.${operation}`, params, timeout)
+}
+
+export function dataPluginSettings(): Partial<GlobalSettings> {
+  return status && hasLocalPairing()
+    ? {
+        pluginSystemEnabled: status.enabled,
+        disabledPlugins: status.disabledPlugins
+      }
