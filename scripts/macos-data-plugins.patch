+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { getWailsFinderBridge } from './web-finder'
+import {
+  isRevealOrEditorOpenBlocked,
+  getLocalPathOpenOwnerForRoute
+} from '@/lib/files/os-open/local-path-open-guard'
+import { createShellApi } from './web-shell-api'
+
+const fixtures = vi.hoisted(() => ({
+  environment: null as null | { id: string; endpoints: { endpoint: string }[] }
+}))
+vi.mock('../../runtime/client/web-runtime-session', () => ({
+  requireActiveEnvironmentOrNull: () => fixtures.environment
+}))
+
+afterEach(() => {
+  fixtures.environment = null
+  vi.unstubAllGlobals()
+})
+
+describe('Wails Finder reveal', () => {
+  it('enables only the runtime attached to the local window, preserving explicit SSH ownership', async () => {
+    const nativeReveal = vi.fn(async () => ({ ok: true }))
+    const host = '127.0.0.1:16768'
+    vi.stubGlobal('window', {
+      location: { protocol: 'http:', hostname: '127.0.0.1', host },
+      __orcaWailsRevealInFinder: nativeReveal
+    })
+    fixtures.environment = { id: 'here', endpoints: [{ endpoint: `ws://${host}/` }] }
+    expect(isRevealOrEditorOpenBlocked('runtime:here')).toBe(false)
+    expect(isRevealOrEditorOpenBlocked('runtime:another')).toBe(true)
+    expect(isRevealOrEditorOpenBlocked('unresolved')).toBe(true)
+    const sshOwner = getLocalPathOpenOwnerForRoute({
+      runtimeEnvironmentId: 'here',
+      connectionId: 'ssh-target'
+    })
+    expect(isRevealOrEditorOpenBlocked(sshOwner)).toBe(true)
+    await expect(
+      createShellApi().openInFileManager('/tmp/project/example.txt', 'runtime:here')
+    ).resolves.toEqual({ ok: true })
+    expect(sshOwner).toBe('ssh:ssh-target')
+    await expect(
+      createShellApi().openInFileManager('/tmp/project/example.txt', 'ssh:ssh-target')
+    ).resolves.toEqual({ ok: false, reason: 'remote-runtime-unsupported' })
+    expect(nativeReveal).toHaveBeenCalledExactlyOnceWith('/tmp/project/example.txt')
+    fixtures.environment.endpoints.push({ endpoint: 'wss://remote.example/' })
+    expect(isRevealOrEditorOpenBlocked('runtime:here')).toBe(true)
+    expect(getWailsFinderBridge('runtime:here')).toBeUndefined()
+  })
+})
