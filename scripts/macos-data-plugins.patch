+import { expect, it, vi } from 'vitest'
+import { createWebPluginsApi, probeWebDataPlugins } from './web-plugins-api'
+import { callRuntimeResult } from '../../runtime/client/web-runtime-calls'
+
+vi.mock('../../runtime/client/web-runtime-calls', () => ({ callRuntimeResult: vi.fn() }))
+vi.mock('../../runtime/client/web-runtime-session', () => ({
+  requireActiveEnvironmentOrNull: () => ({
+    endpoints: [{ endpoint: 'ws://127.0.0.1:54321' }]
+  })
+}))
+
+it('connects the official plugin page to the paired local host and forwards install approval', async () => {
+  vi.stubGlobal('window', {
+    location: { hostname: '127.0.0.1', protocol: 'http:', host: '127.0.0.1:54321' }
+  })
+  try {
+    const call = vi.mocked(callRuntimeResult)
+    call.mockImplementation(async (method) =>
+      method === 'dataPlugins.status'
+        ? { enabled: true, revision: 1, disabledPlugins: [], hostVersion: '1.4.265' }
+        : []
+    )
+    const api = createWebPluginsApi()
+    const onChange = vi.fn()
+    const unsubscribe = api.onChanged!(onChange)
+    expect(api.dataMarketplace?.available).toBe(false)
+    await probeWebDataPlugins()
+    expect(api.dataMarketplace?.available).toBe(true)
+    expect(api.dataMarketplace?.hostVersion).toBe('1.4.265')
+    expect(onChange).toHaveBeenCalledOnce()
+    unsubscribe()
+    await api.listMarketplaces!()
+    await api.listMarketplacePlugins!()
+    await api.refreshMarketplaces!()
+    expect(call.mock.calls.map(([method]) => method)).toEqual([
+      'dataPlugins.status',
+      'dataPlugins.sources',
+      'dataPlugins.listings',
+      'dataPlugins.refreshSources',
+      'dataPlugins.status'
+    ])
+
+    const review = {
+      marketplaceSourceId: 'official',
+      marketplaceCommit: 'a'.repeat(40),
+      pluginKey: 'publisher.theme',
+      resolvedCommit: 'b'.repeat(40),
+      enableIfData: true as const,
+      expectedFingerprint: 'reviewed'
+    }
+    await api.installMarketplacePlugin!(review)
+    expect(call).toHaveBeenCalledWith('dataPlugins.install', review, 260_000)
+
+    await api.invokeCommand!({ pluginKey: 'publisher.theme', commandId: 'ping' })
+    expect(call).toHaveBeenCalledWith(
+      'dataPlugins.invokeCommand',
+      { pluginKey: 'publisher.theme', commandId: 'ping' },
+      expect.any(Number)
+    )
+    await api.readPanelEntry!({ pluginKey: 'publisher.theme', panelId: 'hello' })
+    expect(call).toHaveBeenCalledWith(
+      'dataPlugins.readPanelEntry',
+      { pluginKey: 'publisher.theme', panelId: 'hello' },
+      expect.any(Number)
+    )
+    await api.readCustomEditorEntry!({ pluginKey: 'publisher.theme', editorId: 'hello' })
+    expect(call).toHaveBeenCalledWith(
+      'dataPlugins.readCustomEditorEntry',
+      { pluginKey: 'publisher.theme', editorId: 'hello' },
+      expect.any(Number)
+    )
+
+    const previousCalls = call.mock.calls.length
+    window.location.hostname = 'example.com'
+    expect(api.dataMarketplace?.available).toBe(false)
+    await expect(api.listMarketplacePlugins!()).rejects.toThrow('local Orca pairing')
+    expect(call.mock.calls).toHaveLength(previousCalls)
+  } finally {
+    vi.unstubAllGlobals()
+  }
+})
