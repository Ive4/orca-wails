@@ -0,0 +1,801 @@
+import { isPluginSourceModulePath } from '../../../shared/plugins/frames/plugin-frame-source-modules'
+import { isAbsolute, join } from 'node:path'
+import { version as desktopVersion } from '../../../../package.json'
+import {
+  normalizePluginConsents,
+  normalizePluginIdList
+} from '../../../shared/plugins/approval/plugin-consent-state'
+import { pluginCatalogReleaseCompatibilityError } from '../../../shared/plugins/manifest/plugin-manifest-compatibility'
+import { COMMUNITY_MARKETPLACE_GIT_SOURCE } from '../../../shared/plugins/catalog/plugin-install-link'
+import { isSameGitRepository } from '../../../shared/plugins/catalog/plugin-marketplace'
+import { pluginHostVersion } from '../../../shared/plugins/installation/plugin-host-version'
+import type { PluginManifest } from '../../../shared/plugins/manifest/plugin-manifest'
+import {
+  DataPluginConsentParams,
+  DataPluginArtifactParams,
+  DataPluginInvokeParams,
+  DataPluginEditorParams,
+  DataPluginInstallSourceParams,
+  DataPluginResolveGitParams,
+  DataPluginPushCloseParams,
+  DataPluginPushParams,
+  DataPluginSettingParams,
+  DataPluginCatalogParams,
+  DataPluginEnablementParams,
+  DataPluginInstallParams,
+  DataPluginKeyParams,
+  DataPluginNewFileParams,
+  DataPluginPreviewParams,
+  DataPluginSystemParams
+} from '../../../shared/rpc-contract/plugins/data-plugin-params'
+import type { Store } from '../../persistence/loading-store/store'
+import {
+  applyPluginConsent,
+  applyPluginEnablement,
+  revokePluginConsent
+} from '../../plugins/activation/plugin-enablement'
+import { PluginKillListService } from '../../plugins/catalog/plugin-kill-list-service'
+import { PluginMarketplaceInstaller } from '../../plugins/catalog/plugin-marketplace-installer'
+import {
+  PluginMarketplaceService,
+  type PluginMarketplaceListing,
+  type PluginMarketplaceSourceState
+} from '../../plugins/catalog/plugin-marketplace-service'
+import { pluginMarketplaceErrorMessage } from '../../plugins/catalog/plugin-marketplace-error-message'
+import { refreshInstalledPluginCatalog } from '../../plugins/catalog/plugin-marketplace-shared-refresh'
+import {
+  installCatalogReleaseWithApproval,
+  readPreviewAccessGrowth
+} from '../../plugins/catalog/plugin-update-approval'
+import { readApprovedPluginNewFileTemplate } from '../../plugins/contributions/plugin-new-file-template'
+import { listPluginsForClients } from '../../plugins/discovery/plugin-client-list'
+import { getPluginsDataDir, getUserPluginsDir } from '../../plugins/discovery/plugin-discovery'
+import {
+  installPluginFromGit,
+  installPluginFromLocalPath
+} from '../../plugins/installation/plugin-install'
+import { resolvePluginGitSource } from '../../plugins/installation/plugin-git-ref-resolution'
+import { uninstallInstalledPlugin } from '../../plugins/installation/plugin-uninstall'
+import { PluginService } from '../../plugins/plugin-service'
+import {
+  readPluginDeclaredSettings,
+  writePluginDeclaredSetting
+} from '../../plugins/storage/plugin-declared-settings'
+import { emitWorktreeLifecycleForPlugins } from '../../plugins/events/plugin-worktree-lifecycle'
+import { defineMethod, defineStreamingMethod, type RpcContext } from '../../runtime/rpc/core'
+import type { OrcaRuntimeService } from '../../runtime/orca-runtime'
+import {
+  bindPluginRuntime,
+  createPluginAgentStatusForwarder,
+  watchPluginWorkspaceContext
+} from '../../plugins/runtime/plugin-runtime-binding'
+import { projectPluginAgentStatusChangedPayload } from '../../plugins/events/plugin-agent-status-event'
+import type { agentHookServer } from '../../agent-hooks/server/agent-hook-server'
+import {
+  PluginReadPanelEntryParams,
+  PluginsPanelActionParams
+} from '../../../shared/rpc-contract/plugins/plugins-params'
+
+const capabilities = [
+  'app-theme',
+  'terminal-theme',
+  'icon-theme',
+  'syntax',
+  'interface-language',
+  'new-file',
+  'worker',
+  'script-panel',
+  'custom-editor'
+] as const
+
+export function pluginManifestUnavailableReason(manifest: PluginManifest): string | null {
+  if (
+    manifest.contributes.panels.some((panel) => panel.ui === 'components') ||
+    manifest.contributes.customEditors.some((editor) => editor.frame === 'isolated')
+  ) {
+    return 'This plugin requires an isolated desktop guest.'
+  }
+  if (
+    [...manifest.contributes.panels, ...manifest.contributes.customEditors].some(({ entry }) =>
+      isPluginSourceModulePath(entry)
+    )
+  ) {
+    return 'Plugin frame source modules require the desktop resource protocol.'
+  }
+  if (manifest.contributes.fonts.length > 0) {
+    return 'Plugin fonts require the desktop resource protocol.'
+  }
+  if (manifest.contributes.vmRecipes.length > 0 || manifest.contributes.statusBarItems.length > 0) {
+    return 'This plugin requires desktop VM recipe or status bar services.'
+  }
+  return null
+}
+
+function unavailableReason(listing: PluginMarketplaceListing, hostVersion: string): string | null {
+  if (listing.blockedByKillList) {
+    return listing.blockedByKillList.reason
+  }
+  if (!listing.release) {
+    return 'Requires a catalog release with a pinned commit and content hash.'
+  }
+  if (listing.release.contributes?.some(({ kind }) => kind === 'fonts')) {
+    return 'Plugin fonts require the desktop resource protocol.'
+  }
+  return pluginCatalogReleaseCompatibilityError(listing.release, hostVersion)
+}
+
+type DataHost = {
+  store: Store
+  service: PluginService
+  catalog: PluginMarketplaceService
+  installer: PluginMarketplaceInstaller
+  hostVersion: string
+  revision: number
+  disposed: boolean
+  writes: Promise<unknown>
+}
+
+let active: DataHost | null = null
+
+export async function startOrcadDataPlugins(
+  store: Store,
+  userDataPath: string,
+  runtime: OrcaRuntimeService,
+  hooks: typeof agentHookServer
+): Promise<() => Promise<void>> {
+  const hostVersion = pluginHostVersion(process.env.ORCA_TAURI_PLUGIN_VERSION ?? desktopVersion)
+  const pluginsDataDir = getPluginsDataDir(userDataPath)
+  const killList = new PluginKillListService({ pluginsDataDir })
+  await killList.initialize()
+  const service = new PluginService({
+    userDataPath,
+    hostVersion,
+    isPluginSystemEnabled: () => store.getSettings().pluginSystemEnabled === true,
+    getDisabledPlugins: () => normalizePluginIdList(store.getSettings().disabledPlugins),
+    getPluginConsents: () => normalizePluginConsents(store.getSettings().pluginConsents),
+    getDevPluginPaths: () => [],
+    headless: true,
+    hostEntryPath: join(__dirname, 'plugin-host-entry.js'),
+    admitManifest: (manifest) => pluginManifestUnavailableReason(manifest) === null,
+    getPluginKillListEntry: (key) => killList.find(key)
+  })
+  const catalog = new PluginMarketplaceService({
+    pluginsDataDir,
+    hostVersion,
+    getKillListEntry: (key) => killList.find(key)
+  })
+  const installer = new PluginMarketplaceInstaller({
+    marketplace: catalog,
+    userDataPath,
+    hostVersion,
+    blockedPluginReason: (key) => killList.reason(key),
+    revokeConsent: (pluginKey) => revokePluginConsent({ store, pluginService: service, pluginKey })
+  })
+  const { ALL_RPC_METHODS } = await import('../../runtime/rpc/methods/rpc-method-registry')
+  const delegate = bindPluginRuntime(service, runtime, hooks, ALL_RPC_METHODS)
+  const forwardAgentStatus = createPluginAgentStatusForwarder(delegate, service)
+  const stopAgentEvents = hooks.subscribeEnrichedStatus((event) => {
+    const payload = projectPluginAgentStatusChangedPayload(event, store)
+    if (payload) {
+      forwardAgentStatus(payload, event.terminalHandle)
+    }
+  })
+  const stopWorkspaceEvents = watchPluginWorkspaceContext({
+    delegate,
+    events: service,
+    onSessionWritten: (listener) => store.onWorkspaceSessionWritten(listener),
+    onStateWritten: (listener) => store.onStateWritten(listener)
+  })
+  const stopWorktreeEvents = runtime.onWorktreeLifecycle((event) =>
+    emitWorktreeLifecycleForPlugins(service, event)
+  )
+  try {
+    await service.initialize()
+  } catch (error) {
+    stopAgentEvents()
+    stopWorkspaceEvents()
+    stopWorktreeEvents()
+    killList.dispose()
+    await service.dispose()
+    throw error
+  }
+  const state: DataHost = {
+    store,
+    service,
+    catalog,
+    installer,
+    hostVersion,
+    revision: 0,
+    disposed: false,
+    writes: Promise.resolve()
+  }
+  active = state
+  const stopChanges = service.onChanged(({ contentPacksChanged }) => {
+    if (contentPacksChanged) {
+      state.revision++
+    }
+  })
+  const refreshSafetyList = () =>
+    void killList.refresh().catch(() => {
+      console.warn('[plugins] could not refresh safety list; using cached state')
+    })
+  const stopKillList = killList.onChanged(() => {
+    void service.reconcileActivationState().catch(() => {
+      console.warn('[plugins] could not reconcile the safety list')
+    })
+  })
+  const stopSettings = store.onSettingsChanged((updates) => {
+    if (updates.pluginSystemEnabled !== undefined) {
+      killList.syncPeriodicRefresh(updates.pluginSystemEnabled)
+      if (updates.pluginSystemEnabled) {
+        refreshSafetyList()
+      }
+      void service
+        .refresh()
+        .catch(() => console.warn('[plugins] could not refresh installed data plugins'))
+    }
+  })
+  if (service.options.isPluginSystemEnabled()) {
+    killList.syncPeriodicRefresh(true)
+    refreshSafetyList()
+  }
+  return async () => {
+    active = null
+    state.disposed = true
+    stopAgentEvents()
+    stopWorkspaceEvents()
+    stopWorktreeEvents()
+    stopSettings()
+    stopChanges()
+    stopKillList()
+    killList.dispose()
+    await state.writes.catch(() => undefined)
+    await service.dispose()
+  }
+}
+
+async function host(requireEnabled = true): Promise<DataHost> {
+  const state = active
+  if (!state) {
+    throw new Error('Data plugins are unavailable on this host.')
+  }
+  await state.service.whenReady()
+  if (requireEnabled && !state.service.options.isPluginSystemEnabled()) {
+    throw new Error('The plugin system is disabled.')
+  }
+  return state
+}
+
+async function mutate<T>(operation: (state: DataHost) => Promise<T>): Promise<T> {
+  const state = await host(false)
+  const write = state.writes
+    .catch(() => undefined)
+    .then(() => {
+      if (state.disposed) {
+        throw new Error('The data plugin host is stopping.')
+      }
+      return operation(state)
+    })
+  state.writes = write
+  return write
+}
+
+function isCommunityCatalog(source: PluginMarketplaceSourceState): boolean {
+  return isSameGitRepository(source.source.url, COMMUNITY_MARKETPLACE_GIT_SOURCE.url)
+}
+
+async function listBuiltInCatalogs(catalog: PluginMarketplaceService) {
+  await Promise.all([
+    catalog.seedOfficialSource(),
+    catalog.seedCommunitySource().catch(() => undefined)
+  ])
+  return (await catalog.listSources()).filter(
+    (source) => source.official || isCommunityCatalog(source)
+  )
+}
+
+async function catalogRelease(state: DataHost, sourceId: string, pluginKey: string) {
+  if (!state.service.options.isPluginSystemEnabled()) {
+    throw new Error('The plugin system is disabled.')
+  }
+  const listing = await state.catalog.findPlugin(sourceId, pluginKey)
+  const community =
+    !listing?.official &&
+    (await state.catalog.listSources()).some(
+      (source) => source.id === sourceId && isCommunityCatalog(source)
+    )
+  const reason =
+    listing && (listing.official || community)
+      ? unavailableReason(listing, state.hostVersion)
+      : 'Plugin is absent from the built-in catalogs.'
+  if (!listing?.release || reason) {
+    throw new Error(reason ?? 'The catalog listing has no pinned release.')
+  }
+  return listing.release
+}
+
+function settingHost(service: PluginService) {
+  return {
+    findValidPlugin: (pluginKey: string) => service.findValidPlugin(pluginKey),
+    userDataPath: service.options.userDataPath,
+    dataChanged: (pluginKey: string, key: string) =>
+      service.panelBridge.dataChanged(pluginKey, 'settings', key)
+  }
+}
+
+function panelOwner(service: PluginService, context: RpcContext): string | null {
+  const { connectionId, signal } = context
+  if (!connectionId || signal?.aborted) {
+    return null
+  }
+  const key = `runtime:${connectionId}`
+  service.panels.bindOwnerSignal(key, signal)
+  return key
+}
+
+const permission = 'host-admin' as const
+export const ORCAD_DATA_PLUGIN_METHODS = [
+  defineMethod({
+    name: 'dataPlugins.status',
+    permission,
+    params: null,
+    handler: () =>
+      active && {
+        capabilities,
+        hostVersion: active.hostVersion,
+        revision: active.revision,
+        enabled: active.service.options.isPluginSystemEnabled(),
+        disabledPlugins: active.service.options.getDisabledPlugins()
+      }
+  }),
+  defineMethod({
+    name: 'dataPlugins.setSystemEnabled',
+    permission,
+    params: DataPluginSystemParams,
+    handler: ({ enabled }) =>
+      mutate(async ({ store, service }) => {
+        store.updateSettings({ pluginSystemEnabled: enabled }, { notifyListeners: true })
+        await service.whenReady()
+      })
+  }),
+  defineMethod({
+    name: 'dataPlugins.catalog',
+    permission,
+    params: DataPluginCatalogParams,
+    handler: async ({ refresh }) => {
+      const { catalog, hostVersion } = await host()
+      const seeded = await catalog.seedOfficialSource()
+      const status = refresh
+        ? await catalog.refreshSourceShared(seeded.id)
+        : ((await catalog.listSources()).find(({ id }) => id === seeded.id) ?? seeded)
+      if (!status.marketplace) {
+        throw new Error(status.error ?? 'The official catalog is unavailable.')
+      }
+      const listings = await catalog.listPlugins()
+      return {
+        warning: status.error,
+        entries: listings
+          .filter((listing) => listing.marketplaceSourceId === seeded.id)
+          .map((listing) => ({
+            pluginKey: listing.pluginKey,
+            marketplaceSourceId: listing.marketplaceSourceId,
+            name: listing.name ?? listing.pluginKey,
+            version: listing.version,
+            description: listing.description,
+            unavailable: unavailableReason(listing, hostVersion)
+          }))
+      }
+    }
+  }),
+  defineMethod({
+    name: 'dataPlugins.preview',
+    permission,
+    params: DataPluginPreviewParams,
+    handler: async ({ marketplaceSourceId, pluginKey }) => {
+      const state = await host()
+      await catalogRelease(state, marketplaceSourceId, pluginKey)
+      const preview = await state.installer.preview(marketplaceSourceId, pluginKey)
+      const hostUnavailableReason = pluginManifestUnavailableReason(preview.manifest)
+      return hostUnavailableReason ? { ...preview, hostUnavailableReason } : preview
+    }
+  }),
+  defineMethod({
+    name: 'dataPlugins.install',
+    permission,
+    params: DataPluginInstallParams,
+    handler: (params) =>
+      mutate(async (state) => {
+        const release = await catalogRelease(state, params.marketplaceSourceId, params.pluginKey)
+        if (
+          (params.contentHash !== undefined && release.contentHash !== params.contentHash) ||
+          release.commit !== params.resolvedCommit
+        ) {
+          throw new Error('The release changed after review.')
+        }
+        const { service, store } = state
+        return installCatalogReleaseWithApproval({
+          pluginKey: params.pluginKey,
+          pluginService: service,
+          install: () =>
+            state.installer.install(params, {
+              manifestError: pluginManifestUnavailableReason
+            }),
+          approve: (pluginKey, reviewedFingerprint) =>
+            applyPluginConsent({
+              store,
+              pluginService: service,
+              pluginKey,
+              reviewedFingerprint,
+              decision: 'approve'
+            }),
+          ...(params.enableIfData && params.expectedFingerprint
+            ? { enableIfData: { expectedFingerprint: params.expectedFingerprint } }
+            : {})
+        })
+      })
+  }),
+  defineMethod({
+    name: 'dataPlugins.list',
+    permission,
+    params: null,
+    handler: async () => {
+      const { service } = await host(false)
+      return service.options.isPluginSystemEnabled() ? listPluginsForClients(service) : []
+    }
+  }),
+  defineMethod({
+    name: 'dataPlugins.setEnabled',
+    permission,
+    params: DataPluginEnablementParams,
+    handler: ({ pluginKey, enabled, reviewedFingerprint }) =>
+      mutate(async ({ store, service }) => {
+        if (enabled && reviewedFingerprint) {
+          await applyPluginConsent({
+            store,
+            pluginService: service,
+            pluginKey,
+            reviewedFingerprint,
+            decision: 'approve'
+          })
+          return listPluginsForClients(service)
+        }
+        await applyPluginEnablement({
+          store,
+          pluginService: service,
+          pluginKey,
+          enabled
+        })
+        return listPluginsForClients(service)
+      })
+  }),
+  defineMethod({
+    name: 'dataPlugins.consent',
+    permission,
+    params: DataPluginConsentParams,
+    handler: (request) =>
+      mutate(async ({ store, service }) => {
+        await applyPluginConsent({ store, pluginService: service, ...request })
+        return listPluginsForClients(service)
+      })
+  }),
+  defineMethod({
+    name: 'dataPlugins.sources',
+    permission,
+    params: null,
+    handler: async () => {
+      const { catalog } = await host()
+      return listBuiltInCatalogs(catalog)
+    }
+  }),
+  defineMethod({
+    name: 'dataPlugins.listings',
+    permission,
+    params: null,
+    handler: async () => {
+      const { catalog, hostVersion } = await host()
+      const community = new Set(
+        (await listBuiltInCatalogs(catalog)).filter(isCommunityCatalog).map((source) => source.id)
+      )
+      return (await catalog.listPlugins())
+        .filter((listing) => listing.official || community.has(listing.marketplaceSourceId))
+        .map((listing) => ({
+          ...listing,
+          hostUnavailableReason: listing.blockedByKillList
+            ? undefined
+            : (unavailableReason(listing, hostVersion) ?? undefined)
+        }))
+    }
+  }),
+  defineMethod({
+    name: 'dataPlugins.refreshSources',
+    permission,
+    params: null,
+    handler: async () => {
+      const { catalog } = await host()
+      const sources = await listBuiltInCatalogs(catalog)
+      return Promise.all(
+        sources.map(async (source) => {
+          try {
+            return await catalog.refreshSourceShared(source.id)
+          } catch (error) {
+            return { ...source, stale: true, error: pluginMarketplaceErrorMessage(error) }
+          }
+        })
+      )
+    }
+  }),
+  defineMethod({
+    name: 'dataPlugins.refresh',
+    permission,
+    params: null,
+    handler: () =>
+      mutate(async ({ service }) => {
+        await service.refresh()
+        return listPluginsForClients(service)
+      })
+  }),
+  defineMethod({
+    name: 'dataPlugins.manifest',
+    permission,
+    params: DataPluginKeyParams,
+    handler: async ({ pluginKey }) =>
+      (await host(false)).service.findValidPlugin(pluginKey)?.manifest ?? null
+  }),
+  defineMethod({
+    name: 'dataPlugins.logs',
+    permission,
+    params: DataPluginKeyParams,
+    handler: async ({ pluginKey }) => (await host(false)).service.getLogs(pluginKey)
+  }),
+  defineMethod({
+    name: 'dataPlugins.previewUpdate',
+    permission,
+    params: DataPluginKeyParams,
+    handler: async ({ pluginKey }) => {
+      const state = await host()
+      await refreshInstalledPluginCatalog(
+        { installer: state.installer, marketplace: state.catalog },
+        pluginKey
+      )
+      const update = await state.installer.findInstalledUpdateListing(pluginKey)
+      if (!update) {
+        throw new Error('This plugin has no catalog source.')
+      }
+      await catalogRelease(state, update.listing.marketplaceSourceId, pluginKey)
+      const preview = await state.installer.previewInstalledUpdate(pluginKey)
+      const installed = state.service.findValidPlugin(pluginKey)
+      return installed
+        ? { ...preview, accessGrowth: await readPreviewAccessGrowth(installed, preview) }
+        : preview
+    }
+  }),
+  defineMethod({
+    name: 'dataPlugins.rollbackVersion',
+    permission,
+    params: DataPluginKeyParams,
+    handler: async ({ pluginKey }) => (await host(false)).installer.rollbackVersion(pluginKey)
+  }),
+  defineMethod({
+    name: 'dataPlugins.rollback',
+    permission,
+    params: DataPluginKeyParams,
+    handler: ({ pluginKey }) =>
+      mutate(async ({ installer, service }) => {
+        const result = await installer.rollback(pluginKey)
+        await service.refresh()
+        return result
+      })
+  }),
+  defineMethod({
+    name: 'dataPlugins.remove',
+    permission,
+    params: DataPluginKeyParams,
