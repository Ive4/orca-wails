--- /dev/null
+++ b/src/renderer/src/web/preload-api/browser/web-html-preview.ts
@@ -0,0 +1,10 @@
+import { getWailsFinderBridge } from './web-finder'
+
+type PreviewHTML = (path: string) => Promise<boolean>
+
+export function getWailsHtmlPreviewBridge(owner: string | null): PreviewHTML | undefined {
+  if (!owner || !getWailsFinderBridge(owner)) {
+    return undefined
+  }
+  return (window as Window & { __orcaWailsPreviewHTML?: PreviewHTML }).__orcaWailsPreviewHTML
+}
