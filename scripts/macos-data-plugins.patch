@@ -0,0 +1,36 @@
+import type { ShellOpenLocalPathResult } from '../../../../../shared/shell/opening/shell-open-types'
+import { parseRoutableExecutionHostId } from '../../../../../shared/execution-host/execution-host'
+import { requireActiveEnvironmentOrNull } from '../../runtime/client/web-runtime-session'
+
+type RevealInFinder = (path: string) => Promise<ShellOpenLocalPathResult>
+
+export function wailsFinderBridge(): RevealInFinder | undefined {
+  if (typeof window === 'undefined') {
+    return undefined
+  }
+  return (window as Window & { __orcaWailsRevealInFinder?: RevealInFinder })
+    .__orcaWailsRevealInFinder
+}
+
+export function getWailsFinderBridge(owner: string): RevealInFinder | undefined {
+  const bridge = wailsFinderBridge()
+  if (!bridge || window.location.hostname !== '127.0.0.1' || window.location.protocol !== 'http:') {
+    return undefined
+  }
+  const environment = requireActiveEnvironmentOrNull()
+  const endpoint = `ws://${window.location.host}`
+  if (
+    !environment?.endpoints.length ||
+    !environment.endpoints.every(({ endpoint: url }) => url === endpoint || url === `${endpoint}/`)
+  ) {
+    return undefined
+  }
+  const host = parseRoutableExecutionHostId(owner)
+  if (
+    host?.kind === 'local' ||
+    (host?.kind === 'runtime' && host.environmentId === environment.id)
+  ) {
+    return bridge
+  }
+  return undefined
+}
