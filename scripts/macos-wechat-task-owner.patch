+const WAILS_QUESTION_KEY_FD = 'ORCA_WAILS_QUESTION_KEY_FD'
+const WAILS_QUESTION_KEY_LENGTH = 64
+const WAILS_QUESTION_KEY_FORMAT = /^[0-9a-f]{64}$/
+const WAILS_QUESTION_METHODS = new Set([
+  'agentSession.history',
+  'agentSession.item',
+  'agentSession.respondToQuestion',
+  'agent.read'
+])
+
+function readWailsQuestionKey(): Buffer | undefined {
+  const inherited = process.env[WAILS_QUESTION_KEY_FD]
+  delete process.env[WAILS_QUESTION_KEY_FD]
+  if (inherited !== '3') {
+    return undefined
+  }
+  const fd = 3
+  try {
+    if (!fstatSync(fd).isFIFO()) {
+      return undefined
+    }
+    try {
+      // The desktop launcher writes and closes the pipe before starting Core.
+      const contents = Buffer.alloc(WAILS_QUESTION_KEY_LENGTH + 1)
+      if (readSync(fd, contents, 0, contents.length, null) !== WAILS_QUESTION_KEY_LENGTH) {
+        return undefined
+      }
+      const key = contents.subarray(0, WAILS_QUESTION_KEY_LENGTH)
+      return WAILS_QUESTION_KEY_FORMAT.test(key.toString('latin1')) ? key : undefined
+    } finally {
+      closeSync(fd)
+    }
+  } catch {
+    return undefined
+  }
+}
+
+const wailsQuestionKey = readWailsQuestionKey()
+
+function isWailsQuestionCall(callerScope: RpcCallerScope, method: string, key: unknown): boolean {
+  return (
+    callerScope.kind === 'owner' &&
+    WAILS_QUESTION_METHODS.has(method) &&
+    wailsQuestionKey !== undefined &&
+    typeof key === 'string' &&
+    key.length === WAILS_QUESTION_KEY_LENGTH &&
+    WAILS_QUESTION_KEY_FORMAT.test(key) &&
+    timingSafeEqual(wailsQuestionKey, Buffer.from(key, 'latin1'))
+  )
+}
