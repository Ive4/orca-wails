@@ -0,0 +1,588 @@
+import { useEffect, useRef, useState } from 'react'
+import { getWailsDesktopBridge } from '@/wails/local-runtime'
+import { Button } from '@/components/ui/button'
+import { Input } from '@/components/ui/input'
+import {
+  Select,
+  SelectContent,
+  SelectItem,
+  SelectTrigger,
+  SelectValue
+} from '@/components/ui/select'
+import { SettingsRow, SettingsSwitchRow } from '../form-controls/SettingsFormControls'
+import { SettingsGroup } from '../section-layout/SettingsGroup'
+import { SettingsSection } from '../section-layout/SettingsSection'
+import type { SettingsRenderContext } from '../page/settings-render-context'
+
+type ComputerUse = { computer_use_backend: string; computer_use_vm_ssh: string }
+type ShellState = {
+  computerUse: ComputerUse
+  globalShortcut: string
+  entries: { menu_bar: boolean; notch: boolean }
+  autostart: boolean
+  notifications: boolean
+  native: {
+    notchAvailable: boolean
+    sound: boolean
+    canRequest: boolean
+    authorized: boolean
+    permission: string
+    qrPNG?: string
+  } | null
+  wechat?: {
+    phase: string
+    message?: string
+    code?: string
+    lastReceived?: number
+    lastSent?: number
+  }
+  appVersion: string
+  coreVersion: string
+  officialVersion: string
+  pendingApp: string
+  pendingCore: string
+  checkApp: boolean
+  checkCore: boolean
+  bundledCore: boolean
+  coreInstalled: boolean
+  rollbackAvailable: boolean
+  running: boolean
+  busy: boolean
+  message: string
+}
+
+const backends = [
+  { value: 'cua', label: 'Cua 本机' },
+  { value: 'cua-vm', label: 'Cua 虚拟机（Lume）' },
+  { value: 'orca', label: 'Orca' }
+]
+const sounds = [
+  ['started', '任务开始'],
+  ['resumed', '任务恢复'],
+  ['finished', '任务结束'],
+  ['waiting', '等待输入'],
+  ['blocked', '任务受阻']
+]
+const wechatPhases: Record<string, string> = {
+  unbound: '未连接',
+  starting: '正在连接',
+  scan: '等待扫码',
+  pin: '等待验证码',
+  verify: '等待确认',
+  connected: '已连接',
+  reconnecting: '正在重连',
+  expired: '连接已失效'
+}
+
+export function renderWailsSettingsSection({ navigation, view }: SettingsRenderContext) {
+  return getWailsDesktopBridge()?.shellSettings ? (
+    <SettingsSection
+      id="orca-wails"
+      title="Orca Wails"
+      description="管理此 Mac 上的任务入口、电脑操控、通知和内核。"
+      searchEntries={navigation.getSectionSearchEntries('orca-wails')}
+    >
+      {view.isSectionMounted('orca-wails') && <WailsSettingsPane />}
+    </SettingsSection>
+  ) : null
+}
+
+function WailsSettingsPane() {
+  const bridge = getWailsDesktopBridge()
+  const blocked = useRef(false)
+  const revision = useRef(0)
+  const [state, setState] = useState<ShellState>()
+  const [error, setError] = useState('')
+  const [pending, setPending] = useState(false)
+  const [computer, setComputer] = useState<ComputerUse>()
+  const [shortcut, setShortcut] = useState<string>()
+  const [pin, setPin] = useState('')
+  const [confirmation, setConfirmation] = useState('')
+  const [saved, setSaved] = useState('')
+
+  useEffect(() => {
+    const session = new AbortController()
+    let reading = false
+    const load = async () => {
+      if (!bridge || blocked.current || reading || document.hidden) return
+      reading = true
+      const currentRevision = revision.current
+      const stillCurrent = () =>
+        !session.signal.aborted && !blocked.current && currentRevision === revision.current
+      try {
+        const snapshot = (await bridge.call(
+          'native.shellState',
+          undefined,
+          session.signal
+        )) as ShellState
+        if (stillCurrent()) setState(snapshot)
+      } catch (cause) {
+        if (stillCurrent()) setError(cause instanceof Error ? cause.message.trim() : String(cause))
+      } finally {
+        reading = false
+      }
+    }
+    void load()
+    const interval = window.setInterval(() => void load(), 1800)
+    return () => {
+      window.clearInterval(interval)
+      session.abort()
+    }
+  }, [bridge])
+
+  async function run(
+    kind: string,
+    payload?: { value?: string; cua?: ComputerUse },
+    after?: () => void
+  ) {
+    if (!bridge || blocked.current) return
+    blocked.current = true
+    revision.current++
+    setPending(true)
+    setConfirmation('')
+    setError('')
+    setSaved('')
+    try {
+      const snapshot = (await bridge.call('native.shellAction', { kind, ...payload })) as ShellState
+      setState(snapshot)
+      after?.()
+    } catch (cause) {
+      setError(cause instanceof Error ? cause.message.trim() : String(cause))
+    } finally {
+      blocked.current = false
+      setPending(false)
+    }
+  }
+
+  if (!state) {
+    return (
+      <p role={error ? 'alert' : 'status'} className="text-sm text-muted-foreground">
+        {error || '正在读取桌面设置…'}
+      </p>
+    )
+  }
+  const busy = pending || state.busy
+  const cua = computer ?? state.computerUse
+  const savedHotkey = state.globalShortcut.replace(/CommandOrControl/i, 'Command')
+  const hotkey = shortcut ?? savedHotkey
+  const alias = cua.computer_use_vm_ssh.trim()
+  const invalidAlias =
+    (alias !== '' && !/^[a-zA-Z0-9_][a-zA-Z0-9_.-]{0,252}$/.test(alias)) ||
+    (cua.computer_use_backend === 'cua-vm' && !alias)
+  const computerChanged =
+    cua.computer_use_backend !== state.computerUse.computer_use_backend ||
+    alias !== state.computerUse.computer_use_vm_ssh
+  const native = state.native
+  const wechat = state.wechat
+
+  const toggle = (label: string, kind: string, checked: boolean, description?: string) => (
+    <SettingsSwitchRow
+      key={kind}
+      label={label}
+      description={description}
+      checked={checked}
+      disabled={busy}
+      onChange={() => void run(kind + (checked ? '_off' : '_on'))}
+    />
+  )
+
+  const command = (
+    name: string,
+    kind: string,
+    description?: string,
+    confirm?: string,
+    unavailable = false
+  ) => (
+    <div key={kind} data-settings-row="">
+      <SettingsRow
+        label={name}
+        description={description}
+        control={
+          <Button
+            variant="outline"
+            size="sm"
+            disabled={busy || unavailable}
+            onClick={() => (confirm ? setConfirmation(kind) : void run(kind))}
+          >
+            {name}
+          </Button>
+        }
+      />
+      {confirm && confirmation === kind && (
+        <div className="flex flex-wrap items-center gap-2 pb-3">
+          <p className="grow basis-44 text-sm">{confirm}</p>
+          <Button size="sm" variant="outline" onClick={() => setConfirmation('')}>
+            取消
+          </Button>
+          <Button size="sm" variant="destructive" disabled={busy} onClick={() => void run(kind)}>
+            确认
+          </Button>
+        </div>
+      )}
+    </div>
+  )
+
+  return (
+    <div className="space-y-7">
+      {error && (
+        <p role="alert" className="text-sm text-destructive">
+          {error}
+        </p>
+      )}
+      {(saved || state.message) && (
+        <p role="status" className="text-sm text-muted-foreground">
+          {saved || state.message}
+        </p>
+      )}
+
+      <SettingsGroup
+        id="wails-computer"
+        title="电脑操控"
+        description="设置 Orca 和 Agent 默认使用的操控后端。"
+      >
+        <SettingsRow
+          label="默认后端"
+          htmlFor="wails-cua-backend"
+          control={
+            <Select
+              value={cua.computer_use_backend}
+              disabled={busy}
+              onValueChange={(value) => setComputer({ ...cua, computer_use_backend: value })}
+            >
+              <SelectTrigger id="wails-cua-backend" className="w-48 max-w-full">
+                <SelectValue />
+              </SelectTrigger>
+              <SelectContent>
+                {backends.map(({ value, label }) => (
+                  <SelectItem key={value} value={value}>
+                    {label}
+                  </SelectItem>
+                ))}
+              </SelectContent>
+            </Select>
+          }
+        />
+        <form
+          onSubmit={(event) => {
+            event.preventDefault()
+            if (computerChanged && !invalidAlias)
+              void run('computer_use', { cua: { ...cua, computer_use_vm_ssh: alias } }, () => {
+                setComputer(undefined)
+                setSaved('电脑操控设置已保存')
+              })
+          }}
+        >
+          <SettingsRow
+            label="Lume SSH 别名"
+            htmlFor="wails-cua-host"
+            description={
+              invalidAlias && (alias || computerChanged)
+                ? '请输入有效的 SSH 主机别名。'
+                : '使用 ~/.ssh/config 中的主机别名。单次命令可覆盖默认后端。'
+            }
+            control={
+              <div className="flex flex-wrap items-center gap-2">
+                <Input
+                  id="wails-cua-host"
+                  className="w-44 max-w-full"
+                  value={cua.computer_use_vm_ssh}
+                  placeholder="orca-lume"
+                  spellCheck={false}
+                  autoComplete="off"
+                  maxLength={253}
+                  aria-invalid={invalidAlias || undefined}
+                  onChange={(event) =>
+                    setComputer({ ...cua, computer_use_vm_ssh: event.target.value })
+                  }
+                />
+                <Button
+                  type="submit"
+                  size="sm"
+                  aria-label="保存电脑操控设置"
+                  disabled={busy || invalidAlias || !computerChanged}
+                >
+                  保存
+                </Button>
+              </div>
+            }
+          />
+        </form>
+      </SettingsGroup>
+
+      <SettingsGroup id="wails-desktop" title="桌面与任务入口">
+        <SettingsSwitchRow
+          label="开机启动"
+          checked={state.autostart}
+          disabled={busy}
+          onChange={() => void run('autostart')}
+        />
+        {toggle('菜单栏猫标', 'menu_bar', state.entries.menu_bar)}
+        {toggle(
+          '刘海面板',
+          'notch',
+          state.entries.notch,
+          native?.notchAvailable ? undefined : '在带刘海的显示器上生效。'
+        )}
+        <form
+          onSubmit={(event) => {
+            event.preventDefault()
+            if (hotkey.trim() && hotkey.trim() !== savedHotkey) {
+              void run('global_shortcut', { value: hotkey }, () => {
+                setShortcut(undefined)
+                setSaved('快捷键已保存')
+              })
+            }
+          }}
+        >
+          <SettingsRow
+            label="打开或关闭 Orca 的全局快捷键"
+            htmlFor="wails-hotkey"
+            control={
+              <div className="flex flex-wrap items-center gap-2">
+                <Input
+                  id="wails-hotkey"
+                  className="w-44 max-w-full"
+                  placeholder="Command+Shift+O"
+                  value={hotkey}
+                  maxLength={80}
+                  onChange={(event) => setShortcut(event.target.value)}
+                />
+                <Button
+                  type="submit"
+                  size="sm"
+                  aria-label="保存快捷键"
+                  disabled={busy || !hotkey.trim() || hotkey.trim() === savedHotkey}
+                >
+                  保存
+                </Button>
+              </div>
+            }
+          />
+        </form>
+      </SettingsGroup>
+
+      <SettingsGroup id="wails-notices" title="通知">
+        {toggle('任务与应用通知', 'notifications', state.notifications)}
+        {native && (
+          <>
+            <SettingsSwitchRow
+              label="播放提示音"
+              checked={native.sound}
+              disabled={busy || !state.notifications}
+              onChange={() =>
+                void run('notification_sound', { value: native.sound ? 'off' : 'on' })
+              }
+            />
+            <SettingsRow
+              label="试听任务提示音"
+              htmlFor="wails-sound"
+              control={
+                <Select
+                  value=""
+                  disabled={busy || !state.notifications || !native.sound}
+                  onValueChange={(value) => void run('notification_preview', { value })}
+                >
+                  <SelectTrigger id="wails-sound">
+                    <SelectValue placeholder="选择声音" />
+                  </SelectTrigger>
+                  <SelectContent>
+                    {sounds.map(([value, label]) => (
+                      <SelectItem key={value} value={value}>
+                        {label}
+                      </SelectItem>
+                    ))}
+                  </SelectContent>
+                </Select>
+              }
+            />
+            <SettingsRow
+              label="系统通知权限"
+              description={native.permission}
+              control={
+                <div className="flex flex-wrap gap-2">
+                  {native.canRequest && (
+                    <Button
+                      variant="outline"
+                      size="sm"
+                      disabled={busy || !state.notifications}
+                      onClick={() => void run('notification_permission')}
+                    >
+                      请求权限
+                    </Button>
+                  )}
+                  <Button
+                    variant="outline"
+                    size="sm"
+                    onClick={() => void run('notification_system')}
+                  >
+                    打开系统设置
+                  </Button>
+                  <Button
+                    variant="outline"
+                    size="sm"
+                    disabled={busy || !state.notifications || !native.authorized}
+                    onClick={() => void run('notification_test')}
+                  >
+                    发送测试通知
+                  </Button>
+                </div>
+              }
+            />
+          </>
+        )}
+      </SettingsGroup>
+
+      {wechat && (
+        <SettingsGroup id="wails-wechat" title="微信">
+          <SettingsRow
+            label={wechatPhases[wechat.phase] ?? '状态不可用'}
+            description={wechat.message}
+            control={
+              wechat.phase === 'unbound' || wechat.phase === 'expired' ? (
+                <Button size="sm" disabled={busy} onClick={() => void run('wechat_start')}>
+                  {wechat.phase === 'expired' ? '重新连接' : '连接微信'}
+                </Button>
+              ) : ['starting', 'scan', 'pin', 'verify'].includes(wechat.phase) ? (
+                <Button
+                  variant="outline"
+                  size="sm"
+                  disabled={busy}
+                  onClick={() => void run('wechat_cancel', undefined, () => setPin(''))}
+                >
+                  取消连接
+                </Button>
+              ) : null
+            }
+          />
+          {wechat.phase === 'scan' && native?.qrPNG && (
+            <div className="space-y-2 py-3">
+              <p className="text-sm">用手机微信扫一扫，按提示确认。</p>
+              <img
+                className="size-40 bg-white p-3 [image-rendering:pixelated]"
+                src={'data:image/png;base64,' + native.qrPNG}
+                alt="微信连接二维码"
+              />
+            </div>
+          )}
+          {wechat.phase === 'pin' && (
+            <form
+              onSubmit={(event) => {
+                event.preventDefault()
+                if (/^\d{4,8}$/.test(pin)) void run('wechat_pin', { value: pin }, () => setPin(''))
+              }}
+            >
+              <SettingsRow
+                label="手机微信显示的验证码"
+                htmlFor="wails-wechat-pin"
+                control={
+                  <div className="flex flex-wrap gap-2">
+                    <Input
+                      id="wails-wechat-pin"
+                      className="w-28"
+                      type="password"
+                      inputMode="numeric"
+                      maxLength={8}
+                      value={pin}
+                      onChange={(event) => setPin(event.target.value)}
+                    />
+                    <Button size="sm" disabled={busy || !/^\d{4,8}$/.test(pin)}>
+                      提交
+                    </Button>
+                  </div>
+                }
+              />
+            </form>
+          )}
+          {wechat.phase === 'verify' && (
+            <p className="py-3 text-sm">
+              {wechat.code ? (
+                <>
+                  在微信 Bot 私聊中发送配对码 <code className="select-all">{wechat.code}</code>
+                </>
+              ) : (
+                '在手机微信中完成确认。'
+              )}
+            </p>
+          )}
+          {['connected', 'reconnecting'].includes(wechat.phase) && (
+            <>
+              <SettingsRow
+                label="最近收发"
+                description={`收信 ${wechat.lastReceived ? new Date(wechat.lastReceived * 1000).toLocaleString() : '尚无记录'} · 发信 ${wechat.lastSent ? new Date(wechat.lastSent * 1000).toLocaleString() : '尚无记录'}`}
+                control={
+                  <Button
+                    variant="outline"
+                    size="sm"
+                    disabled={busy || wechat.phase !== 'connected'}
+                    onClick={() => void run('wechat_test')}
+                  >
+                    测试通知
+                  </Button>
+                }
+              />
+              {command(
+                '解除微信绑定',
+                'wechat_disconnect',
+                undefined,
+                '解除后将停止任务通知，旧配对码和回复码会失效。'
+              )}
+            </>
+          )}
+        </SettingsGroup>
+      )}
+
+      <SettingsGroup id="wails-maintenance" title="关于与更新">
+        <SettingsRow
+          label="Orca Wails"
+          control={<span className="text-sm tabular-nums">{state.appVersion}</span>}
+        />
+        <SettingsRow
+          label="Orca Core"
+          control={<span className="text-sm tabular-nums">{state.coreVersion || '未安装'}</span>}
+        />
+        {state.checkApp &&
+          (state.pendingApp
+            ? command('安装应用更新', 'install_app', state.pendingApp, '应用会下载更新并重启。')
+            : command('检查应用更新', 'check_app'))}
+        {state.checkCore &&
+          !state.bundledCore &&
+          (state.pendingCore
+            ? command(
+                '安装内核更新',
+                'install_core',
+                state.pendingCore,
+                '更新会重启内核，正在运行的任务会结束。'
+              )
+            : command('检查内核更新', 'check_core'))}
+        {command('查询官方最新版本', 'check_official', state.officialVersion)}
+      </SettingsGroup>
+
+      <SettingsGroup id="wails-core" title="迁移与内核维护">
+        {command('连接官方 Orca…', 'open_paired', '打开配对页面。')}
+        {command(
+          '从官方 Orca 导入…',
+          'import_official',
+          undefined,
+          '会先备份原数据并重启内核，正在运行的任务会结束。'
+        )}
+        {state.running
+          ? command('重启内核', 'restart', undefined, '重启会结束正在运行的任务。')
+          : command('启动内核', 'start', undefined, undefined, !state.coreInstalled)}
+        {command('停止内核', 'stop', undefined, '停止会结束正在运行的任务。', !state.running)}
+        {!state.bundledCore &&
+          command(
+            '回退内核',
+            'rollback',
+            undefined,
+            '回退会结束正在运行的任务。',
+            !state.rollbackAvailable
+          )}
+        {command('打开配置文件', 'config')}
+        {command('打开日志目录', 'logs')}
+        {command('打开数据目录', 'data')}
+        {command('关闭 Orca 窗口', 'close_orca')}
+        {command('退出 Orca Wails', 'quit', undefined, '退出会停止后台运行的任务。')}
+      </SettingsGroup>
+    </div>
+  )
+}
