@@ -0,0 +1,320 @@
+import type { AgentSessionOutputMetrics } from '../../../../shared/agent-session/agent-session-output-metrics'
+import { readRecord } from '../../app-server/codex-item-field-readers'
+import { readCodexThreadItem } from '../items/codex-thread-item-identity'
+import { measureCodexRequestRate, type RequestReply } from './codex-request-rate'
+import {
+  codexThreadStoppedRunning,
+  codexThreadWaitsOnUser,
+  readCodexTurnId
+} from '../../app-server/codex-structured-thread-facts'
+
+const SAMPLE_BUCKET_MS = 250
+const SAMPLE_WINDOW_MS = 5_000
+const OUTPUT_EXPIRY_MS = 4_000
+const MIN_SAMPLE_SPAN_MS = 2_000
+const REQUEST_EXPIRY_MS = 60_000
+const MIN_CALIBRATION_TOKENS = 40
+const WORD_OR_SYMBOL = /\w+|[^\s\w]/gu
+const TOOL_ITEMS = new Set([
+  'commandExecution',
+  'fileChange',
+  'mcpToolCall',
+  'dynamicToolCall',
+  'collabAgentToolCall',
+  'webSearch',
+  'imageView',
+  'imageGeneration'
+])
+
+type Sample = {
+  firstAt: number
+  lastAt: number
+  firstTokens: number
+  tokens: number
+}
+
+type ActiveTurn = {
+  id: string
+  baseline: number | undefined
+  reportedUsage: boolean
+  reply?: RequestReply | null
+  lastRate?: { tokensPerSecond: number; measuredAt: number }
+}
+
+/** One acquisition owns the counters for its primary thread. No transcript text is retained. */
+export class CodexOutputMetrics {
+  private threadTotal: number | undefined
+  private active: ActiveTurn | undefined
+  private settledTurnId: string | undefined
+  private readonly activeTools = new Set<string>()
+  private visible: { itemId: string; samples: Sample[]; endsInWord: boolean } | undefined
+  private visibleTokenScale: number | undefined
+
+  constructor(
+    private readonly threadId: string,
+    freshThread: boolean
+  ) {
+    this.threadTotal = freshThread ? 0 : undefined
+  }
+
+  observe(threadId: string, method: string, params: unknown, now: number): void {
+    if (threadId !== this.threadId) {
+      return
+    }
+    switch (method) {
+      case 'turn/started': {
+        const id = readCodexTurnId(params)
+        if (id && id !== this.active?.id && id !== this.settledTurnId) {
+          if (this.active) {
+            this.threadTotal = undefined
+          }
+          this.active = { id, baseline: this.threadTotal, reportedUsage: false }
+          this.activeTools.clear()
+          this.visible = undefined
+        }
+        return
+      }
+      case 'turn/completed': {
+        if (this.active && readCodexTurnId(params) === this.active.id) {
+          if (!this.active.reportedUsage) {
+            this.threadTotal = undefined
+          }
+          this.settledTurnId = this.active.id
+          this.active = undefined
+          this.activeTools.clear()
+          this.visible = undefined
+        }
+        return
+      }
+      case 'thread/reverted':
+        this.reset()
+        return
+      case 'model/rerouted':
+        this.visibleTokenScale = undefined
+        if (this.active) {
+          this.active.lastRate = undefined
+          this.active.reply = null
+        }
+        return
+      case 'thread/tokenUsage/updated':
+        this.observeUsage(params)
+        return
+      case 'item/agentMessage/delta':
+        this.observeVisibleDelta(params, now)
+        return
+      case 'item/started':
+      case 'item/completed': {
+        const turnId = readCodexTurnId(params)
+        if (!this.active || (turnId && turnId !== this.active.id)) {
+          return
+        }
+        const item = readCodexThreadItem(readRecord(params).item)
+        if (!item) {
+          return
+        }
+        const reply = this.active.reply
+        if (item.type === 'agentMessage' && method === 'item/completed') {
+          if (
+            reply?.itemId === item.id &&
+            turnId === this.active.id &&
+            typeof item.text === 'string'
+          ) {
+            reply.estimatedTokens = estimateTextTokens(item.text)
+          } else {
+            this.active.reply = null
+          }
+        } else if (
+          item.type !== 'agentMessage' &&
+          item.type !== 'reasoning' &&
+          item.type !== 'userMessage' &&
+          (method === 'item/started' || !this.activeTools.has(item.id))
+        ) {
+          // Tool arguments count in provider usage. Exclude requests that generated them.
+          this.active.reply = null
+        }
+
+        if (method === 'item/started') {
+          this.visible = undefined
+          if (TOOL_ITEMS.has(item.type)) {
+            this.activeTools.add(item.id)
+          }
+        } else {
+          this.activeTools.delete(item.id)
+          if (item.id === this.visible?.itemId) {
+            this.visible = undefined
+          }
+        }
+        return
+      }
+      case 'thread/status/changed':
+        if (codexThreadStoppedRunning(params) || codexThreadWaitsOnUser(params)) {
+          this.pauseVisibleOutput(threadId)
+        }
+    }
+  }
+
+  /** Rewinding can replace the cumulative count even when its next report is larger. */
+  reset(): void {
+    this.threadTotal = undefined
+    this.visibleTokenScale = undefined
+    this.active = undefined
+    this.settledTurnId = undefined
+    this.visible = undefined
+    this.activeTools.clear()
+  }
+
+  pauseVisibleOutput(threadId: string): void {
+    if (threadId === this.threadId) {
+      this.visible = undefined
+      if (this.active) {
+        this.active.reply = null
+      }
+    }
+  }
+
+  read(turnId: string, now: number): AgentSessionOutputMetrics | undefined {
+    const active = this.active
+    if (!active || turnId !== active.id) {
+      return undefined
+    }
+    const result = this.readVisible(now)
+    const lastRate = active.lastRate
+    if (
+      result.visibleTokensPerSecond === undefined &&
+      lastRate &&
+      now >= lastRate.measuredAt &&
+      now < lastRate.measuredAt + REQUEST_EXPIRY_MS
+    ) {
+      result.visibleTokensPerSecond = lastRate.tokensPerSecond
+      result.visibleUntil = lastRate.measuredAt + REQUEST_EXPIRY_MS
+      result.requestRate = true
+    }
+    if (active.baseline !== undefined && this.threadTotal !== undefined) {
+      const outputTokens = this.threadTotal - active.baseline
+      if (outputTokens > 0) {
+        result.turnOutputTokens = outputTokens
+      }
+    }
+    if (this.activeTools.size > 0) {
+      result.toolActive = true
+    }
+    return result.visibleTokensPerSecond !== undefined || result.turnOutputTokens !== undefined
+      ? result
+      : undefined
+  }
+
+  private observeUsage(params: unknown): void {
+    const turnId = readCodexTurnId(params)
+    const expectedTurn = this.active?.id ?? this.settledTurnId
+    if (!turnId || (expectedTurn && turnId !== expectedTurn)) {
+      return
+    }
+    const usage = readRecord(readRecord(params).tokenUsage)
+    const next = readRecord(usage.total).outputTokens
+    if (typeof next !== 'number' || !Number.isSafeInteger(next) || next < 0) {
+      return
+    }
+    if (this.active) {
+      if (this.threadTotal !== undefined && next < this.threadTotal) {
+        this.active.baseline = undefined
+      }
+      if (next !== this.threadTotal) {
+        const outputIncrease = this.threadTotal === undefined ? undefined : next - this.threadTotal
+        const measurement = measureCodexRequestRate(
+          this.active.reply,
+          readRecord(usage.last),
+          outputIncrease
+        )
+        if (measurement?.lastRate) {
+          this.active.lastRate = measurement.lastRate
+        }
+        if (measurement && measurement.estimatedTokens >= MIN_CALIBRATION_TOKENS) {
+          this.visibleTokenScale =
+            this.visibleTokenScale === undefined
+              ? measurement.scale
+              : (this.visibleTokenScale + measurement.scale) / 2
+        }
+        this.active.reply = undefined
+      }
+      this.active.reportedUsage = true
+    }
+    this.threadTotal = next
+  }
+
+  private observeVisibleDelta(params: unknown, at: number): void {
+    if (
+      !this.active ||
+      this.activeTools.size > 0 ||
+      readCodexTurnId(params) !== this.active.id ||
+      !Number.isSafeInteger(at)
+    ) {
+      return
+    }
+    const { delta, itemId } = readRecord(params)
+    if (typeof delta !== 'string' || !delta || typeof itemId !== 'string' || !itemId) {
+      return
+    }
+
+    const existing = this.visible?.itemId === itemId ? this.visible : undefined
+    const last = existing?.samples.at(-1)
+    if (last && at < last.lastAt) {
+      return
+    }
+    const stream =
+      existing && last && at - last.lastAt < OUTPUT_EXPIRY_MS
+        ? existing
+        : { itemId, samples: [], endsInWord: false }
+    // An ASCII word can straddle provider chunks.
+    const tokens = estimateTextTokens(delta) - (stream.endsInWord && /^\w/.test(delta) ? 1 : 0)
+    stream.endsInWord = /\w/.test(delta.at(-1) ?? '')
+    this.visible = stream
+
+    const reply = this.active.reply
+    if (reply === undefined) {
+      this.active.reply = { itemId, firstAt: at, lastAt: at, firstTokens: tokens, paused: false }
+    } else if (reply) {
+      if (reply.itemId !== itemId || reply.estimatedTokens !== undefined) {
+        this.active.reply = null
+      } else if (at >= reply.lastAt) {
+        reply.paused ||= at - reply.lastAt >= OUTPUT_EXPIRY_MS
+        reply.lastAt = at
+      }
+    }
+
+    const sample = stream.samples.at(-1)
+    if (sample && at - sample.firstAt < SAMPLE_BUCKET_MS) {
+      sample.tokens += tokens
+      sample.lastAt = at
+    } else {
+      stream.samples.push({ firstAt: at, lastAt: at, firstTokens: tokens, tokens })
+    }
+    while (stream.samples[0] && stream.samples[0].firstAt < at - SAMPLE_WINDOW_MS) {
+      stream.samples.shift()
+    }
+  }
+
+  private readVisible(now: number): AgentSessionOutputMetrics {
+    const samples = this.visible?.samples
+    const last = samples?.at(-1)
+    if (!samples || !last || now < last.lastAt || now - last.lastAt >= OUTPUT_EXPIRY_MS) {
+      return {}
+    }
+    const recent = samples.filter((sample) => sample.firstAt >= now - SAMPLE_WINDOW_MS)
+    const first = recent[0]
+    if (!first || last.lastAt - first.firstAt < MIN_SAMPLE_SPAN_MS) {
+      return {}
+    }
+    // The preceding interval for the first chunk is unknown.
+    const tokens = recent.reduce((total, sample) => total + sample.tokens, -first.firstTokens)
+    const rate = Math.round(
+      (tokens * (this.visibleTokenScale ?? 1) * 1_000) / (last.lastAt - first.firstAt)
+    )
+    return rate > 0
+      ? { visibleTokensPerSecond: rate, visibleUntil: last.lastAt + OUTPUT_EXPIRY_MS }
+      : {}
+  }
+}
+
+function estimateTextTokens(text: string): number {
+  return text.match(WORD_OR_SYMBOL)?.length ?? 0
+}
