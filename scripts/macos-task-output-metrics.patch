--- /dev/null
+++ b/src/main/codex/structured/session-lifecycle/codex-request-rate.ts
@@ -0,0 +1,56 @@
+const MIN_REQUEST_SPAN_MS = 3_000
+
+export type RequestReply = {
+  itemId: string
+  firstAt: number
+  lastAt: number
+  firstTokens: number
+  paused: boolean
+  estimatedTokens?: number
+}
+
+/** Pair a request's reported non-reasoning output with its observed assistant text. */
+type RequestRateMeasurement = {
+  scale: number
+  estimatedTokens: number
+  lastRate?: { tokensPerSecond: number; measuredAt: number }
+}
+
+export function measureCodexRequestRate(
+  reply: RequestReply | null | undefined,
+  last: Record<string, unknown>,
+  outputIncrease: number | undefined
+): RequestRateMeasurement | undefined {
+  const { outputTokens, reasoningOutputTokens } = last
+  // The latest request must account for the entire increase since the previous report.
+  if (
+    !reply ||
+    !reply.estimatedTokens ||
+    outputIncrease === undefined ||
+    outputTokens !== outputIncrease ||
+    typeof reasoningOutputTokens !== 'number' ||
+    !Number.isSafeInteger(reasoningOutputTokens) ||
+    reasoningOutputTokens < 0 ||
+    reasoningOutputTokens >= outputTokens
+  ) {
+    return
+  }
+  const scale = (outputTokens - reasoningOutputTokens) / reply.estimatedTokens
+  if (scale < 0.25 || scale > 6) {
+    return
+  }
+  const result: RequestRateMeasurement = {
+    scale,
+    estimatedTokens: reply.estimatedTokens
+  }
+  const elapsedMs = reply.lastAt - reply.firstAt
+  if (!reply.paused && elapsedMs >= MIN_REQUEST_SPAN_MS) {
+    // The first packet arrived before we could time how long its tokens took.
+    const tokens = (reply.estimatedTokens - reply.firstTokens) * scale
+    const rate = Math.round((tokens * 1_000) / elapsedMs)
+    if (rate > 0) {
+      result.lastRate = { tokensPerSecond: rate, measuredAt: reply.lastAt }
+    }
+  }
+  return result
+}
