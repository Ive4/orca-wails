@@ -0,0 +1,236 @@
+import { describe, expect, it } from 'vitest'
+import { CodexOutputMetrics } from './codex-output-metrics'
+
+function turn(metrics: CodexOutputMetrics, method: 'started' | 'completed', id: string) {
+  metrics.observe('thread', `turn/${method}`, { turn: { id } }, 1_000)
+}
+
+function usage(metrics: CodexOutputMetrics, turnId: string, outputTokens: number) {
+  metrics.observe(
+    'thread',
+    'thread/tokenUsage/updated',
+    {
+      turnId,
+      tokenUsage: { total: { outputTokens, reasoningOutputTokens: 20 } }
+    },
+    1_000
+  )
+}
+
+function delta(metrics: CodexOutputMetrics, at: number, text: string, threadId = 'thread') {
+  metrics.observe(
+    threadId,
+    'item/agentMessage/delta',
+    {
+      turnId: 'one',
+      itemId: 'message',
+      delta: text
+    },
+    at
+  )
+}
+
+describe('Codex task output metrics', () => {
+  it('uses cumulative output as reported, clearing the measurement between turns', () => {
+    const metrics = new CodexOutputMetrics('thread', true)
+    turn(metrics, 'started', 'one')
+    expect(metrics.read('one', 1_000)).toBeUndefined()
+    usage(metrics, 'one', 70)
+    usage(metrics, 'one', 70)
+    expect(metrics.read('one', 1_000)).toEqual({ turnOutputTokens: 70 })
+
+    turn(metrics, 'completed', 'one')
+    turn(metrics, 'started', 'one')
+    expect(metrics.read('one', 1_000)).toBeUndefined()
+    turn(metrics, 'started', 'two')
+    usage(metrics, 'one', 85)
+    expect(metrics.read('two', 1_000)).toBeUndefined()
+    usage(metrics, 'two', 110)
+    expect(metrics.read('two', 1_000)).toEqual({ turnOutputTokens: 40 })
+    expect(metrics.read('one', 1_000)).toBeUndefined()
+  })
+
+  it('waits for a complete baseline after resume or a counter reset', () => {
+    const metrics = new CodexOutputMetrics('thread', false)
+    turn(metrics, 'started', 'one')
+    usage(metrics, 'one', 900)
+    usage(metrics, 'one', 950)
+    expect(metrics.read('one', 1_000)).toBeUndefined()
+    turn(metrics, 'completed', 'one')
+
+    turn(metrics, 'started', 'two')
+    usage(metrics, 'two', 955)
+    expect(metrics.read('two', 1_000)).toEqual({ turnOutputTokens: 5 })
+    usage(metrics, 'two', 100)
+    usage(metrics, 'two', 125)
+    expect(metrics.read('two', 1_000)).toBeUndefined()
+    turn(metrics, 'completed', 'two')
+
+    turn(metrics, 'started', 'three')
+    turn(metrics, 'completed', 'three')
+    turn(metrics, 'started', 'four')
+    usage(metrics, 'four', 400)
+    expect(metrics.read('four', 1_000)).toBeUndefined()
+  })
+
+  it('invalidates the count on same-thread history rewind even when the next total is higher', () => {
+    const metrics = new CodexOutputMetrics('thread', true)
+    turn(metrics, 'started', 'one')
+    usage(metrics, 'one', 100)
+    turn(metrics, 'completed', 'one')
+    metrics.observe('thread', 'thread/reverted', {}, 2_000)
+
+    turn(metrics, 'started', 'two')
+    usage(metrics, 'two', 130)
+    expect(metrics.read('two', 3_000)).toBeUndefined()
+  })
+
+  it('measures only fresh main-thread assistant text and ignores the first chunk', () => {
+    const metrics = new CodexOutputMetrics('thread', true)
+    turn(metrics, 'started', 'one')
+    delta(metrics, 1_000, 'Opening chunk')
+    expect(metrics.read('one', 1_000)).toBeUndefined()
+    delta(metrics, 3_000, '好🙂好🙂')
+    delta(metrics, 3_100, 'ignored child text', 'child')
+    metrics.observe(
+      'thread',
+      'item/reasoning/summaryTextDelta',
+      {
+        turnId: 'one',
+        delta: 'ignored reasoning'
+      },
+      3_200
+    )
+    expect(metrics.read('one', 3_500)).toEqual({
+      visibleTokensPerSecond: 2,
+      visibleUntil: 7_000
+    })
+    expect(metrics.read('one', 7_000)).toBeUndefined()
+    delta(metrics, 7_100, 'new burst')
+    expect(metrics.read('one', 7_100)).toBeUndefined()
+  })
+
+  it('counts a word split across deltas only once', () => {
+    const metrics = new CodexOutputMetrics('thread', true)
+    turn(metrics, 'started', 'one')
+    delta(metrics, 1_000, 're')
+    delta(metrics, 3_000, 'assemble 好! 好!')
+    expect(metrics.read('one', 3_000)).toEqual({
+      visibleTokensPerSecond: 2,
+      visibleUntil: 7_000
+    })
+  })
+
+  it('calibrates and publishes the last request rate before the turn ends', () => {
+    const metrics = new CodexOutputMetrics('thread', true)
+    turn(metrics, 'started', 'one')
+    const tool = { turnId: 'one', item: { type: 'commandExecution', id: 'command' } }
+    metrics.observe('thread', 'item/started', tool, 100)
+    usage(metrics, 'one', 12)
+    metrics.observe('thread', 'item/completed', tool, 500)
+    delta(metrics, 1_000, 'word')
+    delta(metrics, 3_000, ' word'.repeat(20))
+    delta(metrics, 5_000, ' word'.repeat(20))
+    metrics.observe(
+      'thread',
+      'item/completed',
+      {
+        turnId: 'one',
+        item: { type: 'agentMessage', id: 'message', text: `word${' word'.repeat(40)}` }
+      },
+      5_050
+    )
+    const reported = { outputTokens: 102, reasoningOutputTokens: 20 }
+    const total = { outputTokens: 114 }
+    metrics.observe(
+      'thread',
+      'thread/tokenUsage/updated',
+      { turnId: 'one', tokenUsage: { total, last: reported } },
+      5_100
+    )
+    expect(metrics.read('one', 5_100)).toEqual({
+      turnOutputTokens: 114,
+      visibleTokensPerSecond: 20,
+      visibleUntil: 65_000,
+      requestRate: true
+    })
+
+    delta(metrics, 6_000, 'first')
+    usage(metrics, 'one', 114)
+    delta(metrics, 8_000, ' answer'.repeat(10))
+    expect(metrics.read('one', 8_000)).toEqual({
+      turnOutputTokens: 114,
+      visibleTokensPerSecond: 10,
+      visibleUntil: 12_000
+    })
+    expect(metrics.read('one', 65_000)).toEqual({ turnOutputTokens: 114 })
+  })
+
+  it('drops prior samples when tools start, an answer ends or the user must respond', () => {
+    const metrics = new CodexOutputMetrics('thread', true)
+    turn(metrics, 'started', 'one')
+    usage(metrics, 'one', 73)
+    delta(metrics, 1_000, 'first')
+    delta(metrics, 3_000, ' second word')
+    expect(metrics.read('one', 3_000)?.visibleTokensPerSecond).toBe(1)
+    metrics.observe(
+      'thread',
+      'item/started',
+      {
+        turnId: 'one',
+        item: { type: 'commandExecution', id: 'command' }
+      },
+      3_100
+    )
+    expect(metrics.read('one', 3_100)).toEqual({ turnOutputTokens: 73, toolActive: true })
+    metrics.observe(
+      'thread',
+      'item/completed',
+      {
+        turnId: 'one',
+        item: { type: 'commandExecution', id: 'command' }
+      },
+      3_200
+    )
+    expect(metrics.read('one', 3_200)).toEqual({ turnOutputTokens: 73 })
+    delta(metrics, 4_000, 'third')
+    delta(metrics, 6_000, ' fourth word')
+    expect(metrics.read('one', 6_000)?.visibleTokensPerSecond).toBe(1)
+    metrics.observe(
+      'thread',
+      'item/completed',
+      {
+        turnId: 'one',
+        item: { type: 'agentMessage', id: 'message' }
+      },
+      6_100
+    )
+    expect(metrics.read('one', 6_100)).toEqual({ turnOutputTokens: 73 })
+    delta(metrics, 7_000, 'fifth')
+    delta(metrics, 9_000, ' sixth word')
+    expect(metrics.read('one', 9_000)?.visibleTokensPerSecond).toBe(1)
+    metrics.observe(
+      'thread',
+      'thread/status/changed',
+      {
+        status: { type: 'active', activeFlags: ['waitingOnUserInput'] }
+      },
+      9_100
+    )
+    expect(metrics.read('one', 9_100)).toEqual({ turnOutputTokens: 73 })
+  })
+
+  it('measures the recent window and excludes backwards timestamps', () => {
+    const metrics = new CodexOutputMetrics('thread', true)
+    turn(metrics, 'started', 'one')
+    for (let at = 1_000; at <= 8_000; at += 1_000) {
+      delta(metrics, at, at === 3_000 ? '长'.repeat(100) : ' text')
+    }
+    delta(metrics, 5_000, 'out of order')
+    expect(metrics.read('one', 8_500)).toEqual({
+      visibleTokensPerSecond: 1,
+      visibleUntil: 12_000
+    })
+    expect(metrics.read('one', 7_500)).toBeUndefined()
+  })
+})
